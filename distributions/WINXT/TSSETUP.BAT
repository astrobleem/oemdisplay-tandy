@ECHO OFF
REM Fresh installation only. Existing Windows settings are not replaced.
IF NOT "%1"=="" GOTO USAGE
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO NOWIN
IF NOT EXIST C:\WINDOWS\SYSTEM.INI GOTO NOWIN
IF NOT EXIST C:\WINDOWS\WIN.INI GOTO NOWIN
IF NOT EXIST C:\WINXT\TSHELL.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\TSINPUT.DLL GOTO MISSING
IF NOT EXIST C:\WINXT\TSHELL.INI GOTO MISSING
IF NOT EXIST C:\WINXT\SHELLSEL.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\RESERVE.COM GOTO MISSING
IF NOT EXIST C:\WINXT\MATRIX.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\MAZE.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\STARFLD.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\TABOUT.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\PINBALL.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\TCHIME.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\XPCHIME.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\TEXIT.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\TSTART.BAT GOTO MISSING
IF NOT EXIST C:\WINXT\TSCHECK.EXE GOTO MISSING
IF NOT EXIST C:\WINXT\TSREADY.TXT GOTO MISSING
IF EXIST C:\WINXT\SHREADY.TAG GOTO EXISTS
IF EXIST C:\WINXT\SHREADY.NEW GOTO BACKUP
REM This rejects installation while Windows is running, and recovers any journal.
C:\WINXT\SHELLSEL.EXE RECOVER C:\WINDOWS\SYSTEM.INI
IF ERRORLEVEL 1 GOTO FAILED
IF EXIST C:\WINDOWS\TSHELL.EXE GOTO EXISTS
IF EXIST C:\WINDOWS\TSINPUT.DLL GOTO EXISTS
IF EXIST C:\WINDOWS\TSHELL.INI GOTO EXISTS
IF EXIST C:\WINXT\BACKUP\SHELL14\NUL GOTO BACKUP
IF NOT EXIST C:\WINXT\BACKUP\NUL MD C:\WINXT\BACKUP
IF NOT EXIST C:\WINXT\BACKUP\NUL GOTO FAILED
MD C:\WINXT\BACKUP\SHELL14
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /V C:\WINDOWS\SYSTEM.INI C:\WINXT\BACKUP\SHELL14\SYSTEM.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
C:\WINXT\TSCHECK.EXE C:\WINDOWS\SYSTEM.INI C:\WINXT\BACKUP\SHELL14\SYSTEM.INI
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /V C:\WINDOWS\WIN.INI C:\WINXT\BACKUP\SHELL14\WIN.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
C:\WINXT\TSCHECK.EXE C:\WINDOWS\WIN.INI C:\WINXT\BACKUP\SHELL14\WIN.INI
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /V C:\WINXT\TSHELL.EXE C:\WINDOWS\TSHELL.EXE >NUL
IF ERRORLEVEL 1 GOTO FAILED
C:\WINXT\TSCHECK.EXE C:\WINXT\TSHELL.EXE C:\WINDOWS\TSHELL.EXE
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /V C:\WINXT\TSINPUT.DLL C:\WINDOWS\TSINPUT.DLL >NUL
IF ERRORLEVEL 1 GOTO FAILED
C:\WINXT\TSCHECK.EXE C:\WINXT\TSINPUT.DLL C:\WINDOWS\TSINPUT.DLL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /V C:\WINXT\TSHELL.INI C:\WINDOWS\TSHELL.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
C:\WINXT\TSCHECK.EXE C:\WINXT\TSHELL.INI C:\WINDOWS\TSHELL.INI
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /V C:\WINXT\TSREADY.TXT C:\WINXT\SHREADY.NEW >NUL
IF ERRORLEVEL 1 GOTO FAILED
C:\WINXT\TSCHECK.EXE C:\WINXT\TSREADY.TXT C:\WINXT\SHREADY.NEW
IF ERRORLEVEL 1 GOTO FAILED
REN C:\WINXT\SHREADY.NEW SHREADY.TAG
IF ERRORLEVEL 1 GOTO FAILED
IF NOT EXIST C:\WINXT\SHREADY.TAG GOTO FAILED
ECHO TSTART14 installed in C:\WINDOWS.
ECHO Start Windows with: C:\WINXT\WINXT
ECHO Settings and recovery backups are preserved. See C:\WINXT\README.TXT.
GOTO DONE
:EXISTS
ECHO Existing TSHELL files found in C:\WINDOWS. Nothing was overwritten.
ECHO This installer is for a fresh installation. See README.TXT.
GOTO DONE
:BACKUP
ECHO BACKUP\SHELL14 already exists. Keep this backup directory.
ECHO Installation stopped. See README.TXT before retrying.
GOTO DONE
:MISSING
ECHO The C:\WINXT folder is incomplete. Extract the entire package again.
ECHO No shell was installed. Keep existing files and backups.
GOTO DONE
:NOWIN
ECHO Windows 3.0 was not found in C:\WINDOWS. Installation stopped.
ECHO Install Windows and its display driver first. See README.TXT.
GOTO DONE
:FAILED
ECHO Installation stopped after a safety or copy error.
ECHO Keep all files and backups. Do not start TSTART yet. See README.TXT.
GOTO DONE
:USAGE
ECHO From DOS, outside Windows, use C:\WINXT\TSSETUP without arguments.
:DONE
