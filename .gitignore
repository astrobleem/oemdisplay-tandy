# System Directories
WINDOWS/
DOS/
DOSBox-X/
dosfetch/

# Build Artifacts
*.OBJ
*.LNK
*.MAP
*.DRV
*.LOG
*.ZIP
*.EXE
*.COM

# Temporary & Intermediate Files
TNDY16/
_archive/
BLDPART*.BAT
LIBS.LOG
LINK.LOG
TEST.LOG
OUTPUT.TXT

# Project Definitions (if unused in root)
TNDY16.DEF
TNDY16.MAK

# Documentation Clutter (if archived)
*.DOC
*.FRM
WHATSNEW.*
masmsmpl.txt
w3ddkadp.txt

# Keep specific important files if they match above patterns (e.g. tools we might want?)
# But generally we ignore binaries.
!PKZIP.EXE
!PKUNZIP.EXE
# (Only if user actually wants these committed, but usually bad practice.
# User said "more than a few things that we should not be uploading".
# So ignoring all EXE/COM is safer. I'll stick to ignoring them.)

# Host-side packaging caches and conventional private staging locations
__pycache__/
*.pyc
/OEMLOCAL/
/PRIVATE-DISK*/

# Deliberately retained authored test evidence
!docs/altmodes/CGAWIN.LOG
!docs/altmodes/CGA-GUI.LOG


# Verified first-party DOS media staging helper (source/pins beside it)
!/tools/FLASHDISK/PREPXT.EXE
# Generated public/private floppy artifacts stay out of source commits.
/dist/
*.IMG

# RoundRect investigation: raw probe logs are evidence (docs/RRECT.MD).
!docs/rrect/*/RRBENCH.LOG

# Explicitly reviewed MIT runtime and sealed R1 component/overlay archives.
!/tools/WINR1/KIT/mouse/WHEEL.DRV
!/tools/WINR1/KIT/mouse/WHEEL.LNK
!/downloads/R1/WINXT-FIRST-PARTY-R1.zip
!/downloads/R1/WINXT-REDISTRIBUTABLE-OVERLAY-R1.zip

!docs/rrbatch/*/RRBENCH.LOG
!docs/rrbatch/current/*/RRBENCH.LOG
!docs/rrbatch/current/RLE_*.LOG
!docs/rrsync/*/RRBENCH.LOG
!docs/rrsync/R*.LOG

# Exact qualified ColorPlus payload and native replay logs are release inputs.
!docs/pcp/OUTPUT/BASELINE/RRBENCH.LOG
!docs/pcp/OUTPUT/CANDIDATE/RRBENCH.LOG
!docs/pcp/OUTPUT/SHIPPED/RRBENCH.LOG
!tools/CPPACK/PAYLOAD/PCP3216.DRV

# Current qualified HPXY runtime and focused native receipts.
!/tools/DOSINST/BIN/HPXY.DRV
!/docs/QUAL/HPXY/WINDOWS.ZIP
!/docs/QUAL/HPXY/INSTALL.ZIP
!/docs/QUAL/HPDIB/MATRIX.ZIP
