@ECHO OFF
PATH=C:\BIN
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
MASM /L RAWKEY.ASM,RAWKEY.OBJ,RAWKEY.LST; > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 RAWKEY.OBJ,RAWKEY.EXE,RAWKEY.MAP; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od WINKEY.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /MAP /NOE /NOD @WINKEY.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
