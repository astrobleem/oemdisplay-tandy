ECHO OFF
IF NOT EXIST C:\T2EXP\T2RESV.COM GOTO PACKET
IF "%1"=="" GOTO DEFAULT
IF "%2"=="" GOTO USAGE
IF NOT EXIST %1%2\SETUP.EXE GOTO WINDOWS
C:\T2EXP\T2RESV.COM
IF ERRORLEVEL 1 GOTO STOP
%1
CD %2
SETUP
GOTO DONE
:DEFAULT
IF NOT EXIST C:\WINDOWS\SETUP.EXE GOTO WINDOWS
C:\T2EXP\T2RESV.COM
IF ERRORLEVEL 1 GOTO STOP
C:
CD \WINDOWS
SETUP
GOTO DONE
:USAGE
ECHO Usage: INSTALL [drive: \Windows-directory]
ECHO Example: INSTALL D: \WIN30
GOTO DONE
:WINDOWS
ECHO ERROR: Windows directory not found. Use the drive and directory arguments.
GOTO DONE
:PACKET
ECHO ERROR: Extract the complete packet to C:\T2EXP first.
GOTO DONE
:STOP
ECHO Video II reservation failed. Setup was not started.
:DONE
