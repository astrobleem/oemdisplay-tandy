@ECHO OFF
REM Stage six owned Windows 3.0 files only; no installation or OS launch.
IF "%1"=="" GOTO USAGE
IF NOT EXIST OEMSETUP.INF GOTO BADDIR
IF NOT EXIST TNDYV2.DRV GOTO BADDIR
IF EXIST CGA.GR2 GOTO EXISTS
IF EXIST CGALOGO.LGO GOTO EXISTS
IF EXIST CGALOGO.RLE GOTO EXISTS
IF EXIST CGASYS.FON GOTO EXISTS
IF EXIST CGAFIX.FON GOTO EXISTS
IF EXIST CGAOEM.FON GOTO EXISTS
SET T2S1=%1\SYSTEM\CGA.GR2
IF NOT EXIST %T2S1% SET T2S1=%1\CGA.GR2
IF NOT EXIST %T2S1% GOTO MISSING
SET T2S2=%1\SYSTEM\CGALOGO.LGO
IF NOT EXIST %T2S2% SET T2S2=%1\CGALOGO.LGO
IF NOT EXIST %T2S2% GOTO MISSING
SET T2S3=%1\SYSTEM\CGALOGO.RLE
IF NOT EXIST %T2S3% SET T2S3=%1\CGALOGO.RLE
IF NOT EXIST %T2S3% GOTO MISSING
SET T2S4=%1\SYSTEM\CGASYS.FON
IF NOT EXIST %T2S4% SET T2S4=%1\CGASYS.FON
IF NOT EXIST %T2S4% GOTO MISSING
SET T2S5=%1\SYSTEM\CGAFIX.FON
IF NOT EXIST %T2S5% SET T2S5=%1\CGAFIX.FON
IF NOT EXIST %T2S5% GOTO MISSING
SET T2S6=%1\SYSTEM\CGAOEM.FON
IF NOT EXIST %T2S6% SET T2S6=%1\CGAOEM.FON
IF NOT EXIST %T2S6% GOTO MISSING
COPY %T2S1% CGA.GR2 > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY %T2S2% CGALOGO.LGO > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY %T2S3% CGALOGO.RLE > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY %T2S4% CGASYS.FON > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY %T2S5% CGAFIX.FON > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY %T2S6% CGAOEM.FON > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
ECHO Prepared six owned Windows 3.0 support files.
ECHO Keep this completed private staging directory out of redistribution.
GOTO DONE
:USAGE
ECHO Run from the new T2EXP directory: PREPINF C:\WINDOWS
ECHO Source must be your owned Windows 3.0 installation, never Windows 3.1.
GOTO DONE
:BADDIR
ECHO ERROR: Run beside this packet's OEMSETUP.INF and TNDYV2.DRV.
GOTO DONE
:EXISTS
ECHO ERROR: A support file already exists. Nothing copied; no overwrite.
GOTO DONE
:MISSING
ECHO ERROR: A required owned support file is missing. Nothing copied.
GOTO DONE
:COPYFAIL
ECHO ERROR: Copy failed. Preserve partial files; use a fresh directory to retry.
:DONE
SET T2S1=
SET T2S2=
SET T2S3=
SET T2S4=
SET T2S5=
SET T2S6=
