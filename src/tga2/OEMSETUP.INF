; Experimental Video II. Emulated Tandy SL/2 only; 640 KB, Windows 3.0 /R.
; Physical hardware and Windows 3.1 are unqualified. Never use on EX/HX.
; Description is 46 characters; Windows 3.0 OEM descriptions allow 47.
; Original XT Pixels fonts and expanded CGA.GR2 are included.
; Original XTSTATIC.LGO and WXTSPL01.RLE startup assets are included.
[data]
Version = "3.0"
[disks]
a = C:\T2EXP, "EXPERIMENTAL TANDY SL/2 FAMILY ONLY", OEMSETUP.INF
[display]
TNDYV2 = a:TNDYV2.DRV, "EXPERIMENTAL TANDY SL/2 FAMILY ONLY 640x200x16", "200,96,48", a:CGA.GR2, a:XTSTATIC.LGO,,,, a:WXTSPL01.RLE
[sysfonts]
a:XTCSYS.FON, "XT Pixels CGA System", "200,96,48"
[fixedfonts]
a:XTCFIX.FON, "XT Pixels CGA Fixed", "200,96,48"
[oemfonts]
a:XTCOEM.FON, "XT Pixels CGA Terminal", "200,96,48", 1
