@echo off
PATH=C:\BIN
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
ECHO Building Win3.0 8086 probes > PROBEBD.LOG
MASM /t /Mx PROBEASM.ASM; >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od PROBE.C >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @PROBE.RSP >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od PROBECUR.C >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @PROBECUR.RSP >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od PROBEDRW.C >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @PROBEDRW.RSP >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od PROBEBLT.C >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @PROBEBLT.RSP >> PROBEBD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> PROBEBD.LOG
GOTO END
:FAIL
ECHO FAIL >> PROBEBD.LOG
:END
