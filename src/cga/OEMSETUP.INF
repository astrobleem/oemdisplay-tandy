; Native IBM CGA emulation qualified; physical hardware remains unqualified.
; Use adjacent native SETUP for complete font/control installation.
; Separate Setup entries fix logical geometry before Windows starts.
[data]
Version="3.0"
[disks]
a = .,"CGA SOURCE CANDIDATE",OEMSETUP.INF
[display]
cga100 = a:CGA100.DRV,"IBM CGA 160x100 16 colors (experimental)","100,48,40",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cgapan = a:CGAPAN.DRV,"IBM CGA 160x100 view of 320x200 (experimental)","100,48,40",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga320 = a:CGA32C.DRV,"IBM CGA 320x200 4 colors - proportional compact default","200,48,48",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga640 = a:CGA640.DRV,"IBM CGA 640x200 mono (experimental)","200,96,48",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga32c = a:CGA32C.DRV,"IBM CGA 320C - same proportional compact default","200,48,48",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga64c = a:CGA64C.DRV,"IBM CGA 640x200 mono - compact UI","200,48,40",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga320large = a:CGA320.DRV,"IBM CGA 320x200 - LARGE UI legacy opt-in","200,96,48",3:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
[sysfonts]
a:CG1SYS.FON,"Compact 3x5 System","200,48,40"
a:CG1SYS.FON,"CGA100 original proportional 3x5 System","100,48,40"
a:UI6SYS.FON,"Viewport proportional System","200,48,48"
a:XTCSYS.FON,"Viewport proportional System","200,96,48"
[fixedfonts]
a:CG1FIX.FON,"Compact 4x6 Fixed","200,48,40"
a:CG1FIX.FON,"CGA100 original 4x6 Fixed","100,48,40"
a:XTCFIX.FON,"XT CGA Fixed","200,96,48"
a:CG1FIX.FON,"Compact 4x6 Fixed","200,48,48"
[oemfonts]
a:CG1OEM.FON,"Compact 4x6 Terminal","200,48,40",1
a:CG1OEM.FON,"CGA100 original 4x6 Terminal","100,48,40",1
a:XTCOEM.FON,"XT CGA Terminal","200,96,48",1
a:CG1OEM.FON,"Compact 4x6 Terminal","200,48,48",1
