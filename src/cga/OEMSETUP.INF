; Source candidate ONLY. No CGA packet has passed native acceptance.
; Separate Setup entries fix logical geometry before Windows starts.
[data]
Version="3.0"
[disks]
a = .,"CGA SOURCE CANDIDATE",OEMSETUP.INF
[display]
cga100 = a:CGA100.DRV,"IBM CGA 160x100 16 colors (experimental)","100,48,40",a:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga320 = a:CGA320.DRV,"IBM CGA 320x200 4 colors (experimental)","200,96,48",a:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
cga640 = a:CGA640.DRV,"IBM CGA 640x200 mono (experimental)","200,96,48",a:CGA.GR2,a:XTSTATIC.LGO,,,,a:WXTSPL01.RLE
[sysfonts]
a:CG1SYS.FON,"CGA100 original 4x6 System","100,48,40"
a:XTCSYS.FON,"XT CGA System","200,96,48"
[fixedfonts]
a:CG1FIX.FON,"CGA100 original 4x6 Fixed","100,48,40"
a:XTCFIX.FON,"XT CGA Fixed","200,96,48"
[oemfonts]
a:CG1OEM.FON,"CGA100 original 4x6 Terminal","100,48,40",1
a:XTCOEM.FON,"XT CGA Terminal","200,96,48",1
