@ECHO OFF
REM Requires CL and LINK4 on PATH, plus INCLUDE and LIB for Microsoft C6.
CL /nologo /c /G0 /AS /W3 /Od WHEEL.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD WHEEL.OBJ,WHEEL.EXE,WHEEL.MAP,SLIBCE.LIB; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
WHEEL /TEST
GOTO END
:FAIL
ECHO Build failed. See BUILD.LOG.
:END
