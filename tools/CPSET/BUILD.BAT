@ECHO OFF
SET PATH=T:\BIN
SET INCLUDE=T:\INCLUDE
SET LIB=T:\LIB
T:\BIN\CL.EXE /c /AL /G0 /Gs /W3 /Od CPSET.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO END
T:\BIN\LINK4.EXE /NOD /ST:4096 CPSET.OBJ,CPSET.EXE,CPSET.MAP,T:\LIB\LLIBCE.LIB; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO END
T:\BIN\CL.EXE /c /AL /G0 /Gs /W3 /Od /DCP_FAULT /FoCPFAIL.OBJ CPSET.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO END
T:\BIN\LINK4.EXE /NOD /ST:4096 CPFAIL.OBJ,CPFAIL.EXE,CPFAIL.MAP,T:\LIB\LLIBCE.LIB; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO END
ECHO PASS >> BUILD.LOG
:END
EXIT
