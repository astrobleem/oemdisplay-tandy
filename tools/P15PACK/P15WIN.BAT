ECHO OFF
SET P15DRV=%1
SET P15WIN=%2
IF "%P15DRV%"=="" SET P15DRV=C:
IF "%P15WIN%"=="" SET P15WIN=\WINDOWS
IF NOT "%3"=="" GOTO USAGE
IF NOT EXIST %P15DRV%%P15WIN%\WIN.COM GOTO NOWIN
%P15DRV%
CD %P15WIN%
WIN /R
GOTO END
:NOWIN
ECHO Windows was not found. Use P15WIN drive: \Windows-directory.
GOTO END
:USAGE
ECHO Use P15WIN or P15WIN drive: \Windows-directory.
:END
SET P15DRV=
SET P15WIN=
