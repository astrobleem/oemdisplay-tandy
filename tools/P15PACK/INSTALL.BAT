ECHO OFF
SET P15DRV=%1
SET P15WIN=%2
IF "%P15DRV%"=="" SET P15DRV=C:
IF "%P15WIN%"=="" SET P15WIN=\WINDOWS
IF NOT "%3"=="" GOTO USAGE
IF NOT EXIST %P15DRV%%P15WIN%\WIN.COM GOTO NOWIN
IF NOT EXIST %P15DRV%%P15WIN%\SETUP.EXE GOTO NOWIN
IF NOT EXIST C:\P15EXP\OEMSETUP.INF GOTO INCOMPLETE
IF NOT EXIST C:\P15EXP\PC1512.DRV GOTO INCOMPLETE
IF NOT EXIST C:\P15EXP\CGA.GR2 GOTO INCOMPLETE
COPY /B C:\P15EXP\CGA.GR2 %P15DRV%%P15WIN%\SYSTEM\CGA.GR2 > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B C:\P15EXP\PC1512.DRV %P15DRV%%P15WIN%\SYSTEM\PC1512.DRV > NUL
IF ERRORLEVEL 1 GOTO FAILED
%P15DRV%
CD %P15WIN%
ECHO In Setup choose Display, Other, C:\P15EXP.
ECHO Select Amstrad PC1512 640x200 16 colors.
SETUP
GOTO END
:NOWIN
ECHO Windows 3.0 Setup was not found. Use INSTALL drive: \Windows-directory.
GOTO END
:INCOMPLETE
ECHO Run the complete P15SET.EXE to prepare C:\P15EXP first.
GOTO END
:FAILED
ECHO File staging failed. Windows Setup was not started.
GOTO END
:USAGE
ECHO Use INSTALL or INSTALL drive: \Windows-directory.
:END
SET P15DRV=
SET P15WIN=
