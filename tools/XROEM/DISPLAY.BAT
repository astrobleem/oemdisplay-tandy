ECHO OFF
IF NOT EXIST RESERVE.COM GOTO PACKET
IF NOT EXIST OEMSETUP.INF GOTO PACKET
IF NOT EXIST HPXY.DRV GOTO PACKET
IF NOT EXIST CGA.GR2 GOTO PACKET
IF NOT EXIST FIXXT.EXE GOTO PACKET
IF "%1"=="" GOTO DEFAULT
IF "%2"=="" GOTO USAGE
IF NOT "%3"=="" GOTO USAGE
IF NOT EXIST %1%2\SETUP.EXE GOTO WINDOWS
RESERVE.COM
IF ERRORLEVEL 1 GOTO STOP
FIXXT DISPLAY %1%2
IF ERRORLEVEL 1 GOTO FAILED
GOTO DONE
:DEFAULT
IF NOT EXIST C:\WINDOWS\SETUP.EXE GOTO WINDOWS
RESERVE.COM
IF ERRORLEVEL 1 GOTO STOP
FIXXT DISPLAY C:\WINDOWS
IF ERRORLEVEL 1 GOTO FAILED
GOTO DONE
:USAGE
ECHO Usage: DISPLAY [drive: \Windows-directory]
ECHO Example: DISPLAY D: \WIN30
GOTO DONE
:WINDOWS
ECHO Windows directory not found. Use the drive and directory arguments.
GOTO DONE
:PACKET
ECHO Run this entry from the expanded WINXT folder.
GOTO DONE
:STOP
ECHO Video reservation failed. Setup was not started.
GOTO DONE
:FAILED
ECHO Display setup stopped. Read the FIXXT message above.
:DONE
