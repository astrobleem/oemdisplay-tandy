ECHO OFF
IF NOT EXIST C:\WINXT\RESERVE.COM GOTO PACKET
IF NOT EXIST C:\WINXT\OEMSETUP.INF GOTO PACKET
IF NOT EXIST C:\WINXT\HPXY.DRV GOTO PACKET
IF NOT EXIST C:\WINXT\CGA.GR2 GOTO PACKET
IF "%1"=="" GOTO DEFAULT
IF "%2"=="" GOTO USAGE
IF NOT "%3"=="" GOTO USAGE
IF NOT EXIST %1%2\WIN.COM GOTO WINDOWS
C:\WINXT\RESERVE.COM
IF ERRORLEVEL 1 GOTO STOP
%1
CD %2
WIN /R
GOTO DONE
:DEFAULT
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO WINDOWS
C:\WINXT\RESERVE.COM
IF ERRORLEVEL 1 GOTO STOP
C:
CD \WINDOWS
WIN /R
GOTO DONE
:USAGE
ECHO Usage: DISPWIN [drive: \Windows-directory]
ECHO Example: DISPWIN D: \WIN30
GOTO DONE
:WINDOWS
ECHO Windows directory not found. Use the drive and directory arguments.
GOTO DONE
:PACKET
ECHO Extract the complete WINXT folder to C:\WINXT first.
GOTO DONE
:STOP
ECHO Video reservation failed. Windows was not started.
:DONE
