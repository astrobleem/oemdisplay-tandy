ECHO OFF
IF NOT EXIST RESERVE.COM GOTO PACKET
IF NOT EXIST OEMSETUP.INF GOTO PACKET
IF NOT EXIST HPXY.DRV GOTO PACKET
IF NOT EXIST FIXXT.EXE GOTO PACKET
IF NOT EXIST TANDYGR.GR2 GOTO PACKET
IF NOT EXIST TGCLIP.EXE GOTO PACKET
IF "%1"=="" GOTO DEFAULT
IF "%2"=="" GOTO USAGE
IF NOT "%3"=="" GOTO USAGE
IF NOT EXIST %1%2\WIN.COM GOTO WINDOWS
RESERVE.COM
IF ERRORLEVEL 1 GOTO STOP
FIXXT GRABBER %1%2
IF ERRORLEVEL 1 GOTO STOP
%1
CD %2
WIN /R
GOTO DONE
:DEFAULT
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO WINDOWS
RESERVE.COM
IF ERRORLEVEL 1 GOTO STOP
FIXXT GRABBER C:\WINDOWS
IF ERRORLEVEL 1 GOTO STOP
C:
CD \WINDOWS
WIN /R
GOTO DONE
:USAGE
ECHO Usage: DISPWIN [drive: \Windows-directory]
ECHO Example: DISPWIN D: \WIN30
GOTO DONE
:WINDOWS
ECHO Windows directory not found. Use the drive and directory arguments.
GOTO DONE
:PACKET
ECHO Run this entry from the expanded WINXT folder.
GOTO DONE
:STOP
ECHO Video reservation failed. Windows was not started.
:DONE
