ECHO OFF
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO NOWIN
IF NOT EXIST C:\CPPAN\CGA.GR2 GOTO NOGRAB
COPY /B C:\CPPAN\CGA.GR2 C:\WINDOWS\SYSTEM\CGA.GR2 > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B C:\CPPAN\CPPAN.DRV C:\WINDOWS\SYSTEM\CPPAN.DRV > NUL
IF ERRORLEVEL 1 GOTO FAILED
C:
CD \WINDOWS
SETUP
GOTO END
:NOWIN
ECHO Install Windows 3.0 in C:\WINDOWS before running this installer.
GOTO END
:NOGRAB
ECHO Extract the complete CPPAN.ZIP to C:\ before running INSTALL.
GOTO END
:FAILED
ECHO File staging failed. Setup was not started.
:END
