@ECHO OFF
SET PATH=T:\BIN
SET INCLUDE=T:\INCLUDE
CL /nologo /c /G0 /AS /Od /W3 PREPXT.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAILED
LINK4 /NOE /NOD /ST:4096 PREPXT.OBJ,PREPXT.EXE,PREPXT.MAP,T:\LIB\SLIBCE.LIB; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAILED
ECHO SUCCESS>>BUILD.LOG
GOTO DONE
:FAILED
ECHO FAILED>>BUILD.LOG
:DONE
