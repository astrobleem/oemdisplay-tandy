@ECHO OFF
REM Safe DOS entry point. Never call WIN or SETUP before reservation.
IF NOT "%1"=="" IF NOT "%1"=="SETUP" IF NOT "%1"=="setup" GOTO USAGE
IF NOT "%2"=="" GOTO USAGE
IF NOT EXIST C:\TANDY88\RESERVE.COM GOTO NOHELP
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO NOWIN
IF "%1"=="SETUP" IF NOT EXIST C:\WINDOWS\SETUP.EXE GOTO NOWIN
IF "%1"=="setup" IF NOT EXIST C:\WINDOWS\SETUP.EXE GOTO NOWIN
C:\TANDY88\RESERVE.COM
IF ERRORLEVEL 1 GOTO FAILED
REM WINDOWSDRIVE
C:
CD C:\WINDOWS
IF ERRORLEVEL 1 GOTO NOWIN
IF "%1"=="SETUP" GOTO SETUP
IF "%1"=="setup" GOTO SETUP
C:\WINDOWS\WIN.COM /R
GOTO DONE
:SETUP
C:\WINDOWS\SETUP.EXE
GOTO DONE
:NOHELP
ECHO RESERVE.COM missing. Windows and Setup were not started.
GOTO DONE
:NOWIN
ECHO Windows 3.0 files missing in C:\WINDOWS. Nothing started.
GOTO DONE
:FAILED
ECHO Video reservation failed. Windows and Setup were not started.
GOTO DONE
:USAGE
ECHO Use C:\TANDY88\TANDY88 or C:\TANDY88\TANDY88 SETUP
:DONE
