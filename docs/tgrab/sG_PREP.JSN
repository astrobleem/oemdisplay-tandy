 "changes": [
  "CONFIG.SYS: only files=30, buffers=30 (removed HIMEM, SMARTDRV, EGA.SYS: an XT has no XMS and no EGA)",
  "AUTOEXEC.BAT: PATH/TEMP as before, run C:\\XTPAN\\RESERVE, stay at the DOS prompt (no automatic WIN)",
  "SYSTEM.INI: display.drv=TR53216.DRV; [keyboard] type=1 (PC/XT 83-key instead of AT)",
  "WIN.INI: load=C:\\XTPAN\\XTPAN.EXE; [XTPan] LogFile=C:\\XTPAN\\XTPAN.LOG (defaults for Step, Dwell, Edge, keys and FollowActive)",
  "WIN.INI: MouseSpeed=0 (no pointer acceleration, so test moves are exact); Wallpaper=BARS16.BMP (a full-screen 16-colour bar test image, centred)",
  "added WINDOWS/BARS16.BMP: 320x200 4-bit, 16 bars of 20 pixels, palette = the driver's colour table (generated, sha256 42c3959625954073173f743ed2b432c68a75385135dafa1d643c70f93ce38fbe)",
  "added WINDOWS/SYSTEM/TR53216.DRV and XTPAN/RESERVE.COM, MSTEST.COM, XTPAN.EXE, PANTEST.EXE"
 ],
 "86box_cfg": "[General]\nconfirm_exit = 0\nconfirm_reset = 0\nconfirm_save = 0\nvid_renderer = qt_software\nvideo_filter_method = 0\nscale = 3\n\n[Machine]\nmachine = tandy1000hx\ncpu_family = 8088\ncpu_speed = 7159092\ncpu_multi = 1\ncpu_use_dynarec = 0\nmem_size = 640\ntime_sync = disabled\n\n[Video]\ngfxcard = internal\n\n[Input devices]\nmouse_type = none\n\n[Storage controllers]\nhdc_1 = xtide\n\n[PC/XT XTIDE #1]\nbios = xt\n\n[Hard disks]\nhdd_01_fn = pcp.img\nhdd_01_ide_channel = 0:0\nhdd_01_parameters = 17, 4, 615, 0, ide\n\n[Ports (COM & LPT)]\nserial1_enabled = 1\nserial1_device = serial_passthrough\n\n[Serial Passthrough (COM) #1]\npath = @PTY@\nreconnect = 1\n",
