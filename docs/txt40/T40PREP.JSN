 "changes": [
  "CONFIG.SYS: only files=30, buffers=30 (removed HIMEM, SMARTDRV, EGA.SYS: an XT has no XMS and no EGA)",
  "AUTOEXEC.BAT: PATH/TEMP as before, run C:\\T40\\T40ID, stay at the DOS prompt (no automatic WIN)",
  "8x8 fonts: fonts.fon=XTTSYS.FON, fixedfon.fon=XTCFIX.FON, oemfonts.fon=XTCOEM.FON (first-party XT fonts, hashes checked)",
  "SYSTEM.INI: display.drv=TXT40.DRV; [keyboard] type=1 (PC/XT 83-key instead of AT)",
  "WIN.INI: GridGranularity=1 (windows snap to 8-pixel steps)",
  "WIN.INI [fonts]: every entry commented out (Helv 8,10,12,14,18,24 (EGA res)=HELVB.FON; Courier 10,12,15 (EGA res)=COURB.FON; Tms Rmn 8,10,12,14,18,24 (EGA res)=TMSRB.FON; Symbol 8,10,12,14,18,24 (EGA res)=SYMBOLB.FON; Roman (All res)=ROMAN.FON; Script (All res)=SCRIPT.FON; Modern (All res)=MODERN.FON), so the font mapper can only choose the 8x8 System and Terminal fonts",
  "WIN.INI: MouseSpeed=0 (no pointer acceleration, so test moves are exact); Wallpaper=BARS16.BMP (a full-screen 16-colour bar test image, centred)",
  "added WINDOWS/BARS16.BMP: 320x200 4-bit, 16 bars of 20 pixels, palette = the driver's colour table (generated, sha256 42c3959625954073173f743ed2b432c68a75385135dafa1d643c70f93ce38fbe)",
  "added WINDOWS/SYSTEM/TXT40.DRV and T40/T40ID.COM, MSTEST.COM"
 ],
 "86box_cfg": "[General]\nconfirm_exit = 0\nconfirm_reset = 0\nconfirm_save = 0\nvid_renderer = qt_software\nvideo_filter_method = 0\nscale = 3\n\n[Machine]\nmachine = ibmxt86\ncpu_family = 8088\ncpu_speed = 4772728\ncpu_multi = 1\ncpu_use_dynarec = 0\nmem_size = 640\ntime_sync = disabled\n\n[Video]\ngfxcard = cga\n\n[IBM CGA]\ndisplay_type = 0\ncomposite_type = 1\nrgb_type = 0\nsnow_enabled = 1\ndouble_type = 0\n\n[Input devices]\nkeyboard_type = keyboard_pc_xt\nmouse_type = none\n\n[Storage controllers]\nhdc_1 = xtide\n\n[PC/XT XTIDE #1]\nbios = xt\n\n[Hard disks]\nhdd_01_fn = pcp.img\nhdd_01_ide_channel = 0:0\nhdd_01_parameters = 17, 4, 615, 0, ide\n\n[Ports (COM & LPT)]\nserial1_enabled = 1\nserial1_device = serial_passthrough\n\n[Serial Passthrough (COM) #1]\npath = @PTY@\nreconnect = 1\n"
