[sdl]
output=surface
[dosbox]
machine=tandy
[cpu]
core=normal
cycles=3000
[autoexec]
mount c <fresh-output-dir>
c:
JRPROBE.COM >> OUT.TXT
IF ERRORLEVEL 1 GOTO F0
echo JRPROBE EXIT=0 >> OUT.TXT
GOTO D0
:F0
echo JRPROBE EXIT=1 >> OUT.TXT
:D0
JRGUARD.COM >> OUT.TXT
IF ERRORLEVEL 1 GOTO F1
echo JRGUARD EXIT=0 >> OUT.TXT
GOTO D1
:F1
echo JRGUARD EXIT=1 >> OUT.TXT
:D1
T2PROBE.COM >> OUT.TXT
IF ERRORLEVEL 1 GOTO F2
echo T2PROBE EXIT=0 >> OUT.TXT
GOTO D2
:F2
echo T2PROBE EXIT=1 >> OUT.TXT
:D2
exit
