c:
cd \
IF EXIST C:\JRLOG.TXT DEL C:\JRLOG.TXT
ECHO CYCLE START> C:\JRLOG.TXT
C:\JRGUARD.COM
IF ERRORLEVEL 1 GOTO NOGO1
ECHO GUARD1 EXIT=0>> C:\JRLOG.TXT
cd \WINDOWS
WIN /R
cd \
ECHO WIN1 RETURNED>> C:\JRLOG.TXT
C:\JRGUARD.COM
IF ERRORLEVEL 1 GOTO NOGO2
ECHO GUARD2 EXIT=0>> C:\JRLOG.TXT
cd \WINDOWS
WIN /R
cd \
ECHO WIN2 RETURNED>> C:\JRLOG.TXT
C:\JRGUARD.COM
IF ERRORLEVEL 1 GOTO NOGO3
ECHO GUARD3 EXIT=0>> C:\JRLOG.TXT
ECHO CYCLE PASS>> C:\JRLOG.TXT
TYPE C:\JRLOG.TXT
GOTO END
:NOGO1
ECHO GUARD1 NONZERO>> C:\JRLOG.TXT
GOTO SHOW
:NOGO2
ECHO GUARD2 NONZERO>> C:\JRLOG.TXT
GOTO SHOW
:NOGO3
ECHO GUARD3 NONZERO>> C:\JRLOG.TXT
:SHOW
TYPE C:\JRLOG.TXT
:END
