@ECHO OFF
C:
CD \
SETUP C:\WINDOWS < CANCEL.TXT > CANCEL.LOG
IF ERRORLEVEL 1 GOTO FAIL
LEGACY\SETUP C:\WINDOWS 320 > LEGACY.LOG
IF ERRORLEVEL 1 GOTO FAIL
COPY C:\WINDOWS\CGACOPY.STA C:\LEGACY.STA > NUL
SETUP C:\WINDOWS 320C > UPGRADE.LOG
IF ERRORLEVEL 1 GOTO FAIL
COPY C:\WINDOWS\SYSTEM.INI C:\UPGRADED.INI > NUL
SETUP UNDO C:\WINDOWS > LUNDO.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS < CH32.TXT > S32.LOG
IF ERRORLEVEL 1 GOTO FAIL
MD S32
MD S32\SYSTEM
COPY C:\WINDOWS\*.* C:\S32 > NUL
COPY C:\WINDOWS\SYSTEM\*.* C:\S32\SYSTEM > NUL
SETUP C:\WINDOWS < CH64.TXT > S64.LOG
IF ERRORLEVEL 1 GOTO FAIL
MD S64
MD S64\SYSTEM
COPY C:\WINDOWS\*.* C:\S64 > NUL
COPY C:\WINDOWS\SYSTEM\*.* C:\S64\SYSTEM > NUL
SETUP C:\WINDOWS 320 >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS 320C >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS 640 >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS 640C >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS 100 >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS PAN >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP C:\WINDOWS 320 >> SWITCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
SETUP UNDO C:\WINDOWS > UNDO.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS > NATIVE.OK
GOTO DONE
:FAIL
ECHO FAIL > NATIVE.ERR
:DONE
EXIT
