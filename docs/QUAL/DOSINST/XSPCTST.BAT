@ECHO OFF
C:
SET PATH=C:\;C:\WINDOWS;C:\DOS
VER > C:\DOSVER.TXT
B:
C:\NEW.EXE C:\WINDOWS /PREP > C:\SPACE.LOG
IF NOT ERRORLEVEL 1 GOTO FAIL
IF EXIST C:\XR155 GOTO FAIL
ECHO PASS > C:\SPACE.OK
C:\OLD.EXE C:\WINDOWS /PREP > C:\OLD.LOG
IF NOT ERRORLEVEL 1 GOTO FAIL
IF NOT EXIST C:\XR155\XSETUP.EXE GOTO FAIL
DIR C:\XR155\XSETUP.EXE > C:\OLDINFO.LOG
ECHO PASS > C:\OLD.OK
C:\OLD.EXE C:\WINDOWS /PREP > C:\OLD2.LOG
IF NOT ERRORLEVEL 1 GOTO FAIL
DEL C:\FILLER.BIN
DEL C:\WINDOWS\SYSTEM\CGA.GR2
IF EXIST C:\WINDOWS\SYSTEM\CGA.GR2 GOTO FAIL
IF EXIST C:\WINDOWS\CGA.GR2 GOTO FAIL
ECHO PASS > C:\NOCGA.OK
C:\NEW.EXE C:\WINDOWS /PREP > C:\REPAIR.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS > C:\REPAIR.OK
DEL C:\XR155\XSETUP.EXE
C:\FAULT.EXE C:\WINDOWS /PREP > C:\FAULT.LOG
IF NOT ERRORLEVEL 1 GOTO FAIL
IF EXIST C:\XR155\XSETUP.EXE GOTO FAIL
IF EXIST C:\XR155\XS*.NEW GOTO FAIL
ECHO PASS > C:\FAULT.OK
C:\NEW.EXE C:\WINDOWS /PREP > C:\RETRY.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS > C:\RETRY.OK
C:\NEW.EXE C:\WINDOWS
IF ERRORLEVEL 1 GOTO FAIL
ECHO SETUPDONE > C:\SETDONE.TXT
C:\XR155\RESERVE.COM > C:\REUSE.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\COMMAND.COM /C C:\XR155\RUNSYNC.BAT > C:\LAUNCH.LOG
ECHO FINISHED > C:\DONE.TXT
GOTO END
:FAIL
ECHO FAIL > C:\FAIL.TXT
:END
