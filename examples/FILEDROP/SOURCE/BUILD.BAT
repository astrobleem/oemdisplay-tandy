@ECHO OFF
PATH=C:\BIN
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /Gw /AS /W3 /Od TDROP.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LIB TDROP.LIB +TDROP.OBJ; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od /FoDROPTX.OBJ DROPAPP.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od /DRECEIVER /FoDROPRX.OBJ DROPAPP.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @DROPTX.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @DROPRX.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
