  "findings": [
    {
      "id": "PKG-1",
      "priority": "P2",
      "title": "Require current build/source/runtime binding before native qualification is accepted",
      "file": "examples/CUBE/SOURCE/VERIFY.PY",
      "line": 13,
      "end_line": 18,
      "scenario": "A renderer source change updates its ACCEPT.JSN source pin but retains the previously tested runtime and all old build/native receipts. Source and receipt hashes are checked independently; no code compares SRCBIND.JSN or the native build input hashes with the current accepted sources/runtime.",
      "reproduction": "review-package/probe_gates.py changes CUBE.C drawingStyle monochrome Auto selection from Dither (2) to Wire (3) and updates only ACCEPT.source for that file in a scratch closure. All build/SRCBIND/native receipts and runtimes stay unchanged. verify(False) returns READY_FOR_PUBLICATION_APPROVAL.",
      "impact": "PACK and the workflow can accept a source packet that does not describe the tested native binary, despite the existing build/source-binding receipt becoming stale.",
      "requested_fix": "Validate the pinned SRCBIND/build receipt source and runtime maps against the current closure, including installer inputs and required builder/guard sources. Add a negative test for an updated accepted source pin with stale build/native binding.",
      "current_artifact_assessment": "The actual reviewed 0346d47 source/build/runtime binding matches; this is an executable gate defect, not an observed mismatch in the shipped ZIPs.",
      "evidence": "gate-probes.json:changed_render_source_with_old_build_native_receipts"
    },
    {
      "id": "PKG-2",
      "priority": "P2",
      "title": "Validate the complete source ZIP manifest during replay",
      "file": "examples/CUBE/SOURCE/TESTSRC.PY",
      "line": 14,
      "end_line": 24,
      "scenario": "SOURCE.JSN is loaded but only source_commit is used. The replay validates ACCEPT.source only, which excludes required SOURCE/tools/SOUNDOWN/RUNDOS.PY, BUILDAPP.PY and CRCFAST.H. RUNHOST does not use the native build guard, so modifying it is not detected.",
      "reproduction": "review-package/probe_gates.py creates tampered-helper.zip by appending an inert comment to SOURCE/tools/SOUNDOWN/RUNDOS.PY and retaining the original SOURCE.JSN. TESTSRC.PY returns PASS for 162 sources and all four host groups; tampered-helper-replay/RESULT.JSN records the accepted tampered archive.",
      "impact": "The source replay can report an intact source/build closure while a required native build helper differs from the declared archive manifest, and it does not catch omitted or extra non-ACCEPT members either.",
      "requested_fix": "Check the exact ZIP member set against SOURCE.JSN.source plus SOURCE.JSN itself and validate every declared member hash/size before extraction/build. Include required build helpers in the accepted source closure and negative tests for helper modification/removal and extra members.",
      "current_artifact_assessment": "The actual reviewed source ZIP has 334 members and independently matches its full SOURCE.JSN manifest. The weakness is in TESTSRC validation.",
      "evidence": "tampered-helper-replay/RESULT.JSN"
    }
  ],
  "test_gaps": [
    {
      "file": "examples/CUBE/SOURCE/VERIFY.PY",
      "line": 21,
      "gap": "The required role set omits cgapan, t6404, cga320 and t160. Removing all four from ACCEPT.native still returns READY, although TESTS.MD claims eight rendering fixtures. Require the documented fixture set and validate its dimensions, palette, viewport and driver identity.",
      "evidence": "gate-probes.json:missing_four_rendering_roles",
      "current_artifact_assessment": "All eight actual rendering fixtures exist and were independently checked."
    },
    {
      "file": "examples/CUBE/SOURCE/CUBESET.C",
      "line": 52,
      "gap": "Native installer evidence covers successful install, undo, reinstall, unknown-shell refusal and standalone preservation. It does not inject disk-full, failed copy, failed rename, changed backup, interrupted transaction or temporarily absent target cases. The inspected staging/restore order appears to preserve originals, but those recovery paths remain unqualified.",
      "current_artifact_assessment": "No new installer safety defect found by inspection."
    }
  ],
