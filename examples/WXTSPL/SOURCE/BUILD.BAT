@ECHO OFF
CL /nologo /c /G0 /AS /W3 /Od /Fa SPLASH.C
IF ERRORLEVEL 1 GOTO FAIL
LINK /NOE /STACK:8192 SPLASH.OBJ,WXTSPL.EXE,WXTSPL.MAP,SLIBCE.LIB;
IF ERRORLEVEL 1 GOTO FAIL
WXTSPL SELFTEST
IF ERRORLEVEL 1 GOTO FAIL
ECHO Build and SHA-256 self-test passed.
GOTO DONE
:FAIL
ECHO Build or self-test failed. Do not install.
:DONE
