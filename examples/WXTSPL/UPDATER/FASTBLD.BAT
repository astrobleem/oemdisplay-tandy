@ECHO OFF
REM Developer build only. Runtime defaults compare bytes; package pins stay modern-side.
SET PATH=T:\BIN
SET INCLUDE=T:\INCLUDE
CL /nologo /c /G0 /AS /W3 FASTSET.C > FASTBLD.LOG
IF ERRORLEVEL 1 GOTO FAILED
LINK4 /NOE /NOD /ST:8192 FASTSET.OBJ,FASTSET.EXE,FASTSET.MAP,T:\LIB\SLIBCE.LIB; >> FASTBLD.LOG
IF ERRORLEVEL 1 GOTO FAILED
ECHO SUCCESS>>FASTBLD.LOG
GOTO DONE
:FAILED
ECHO FAILED>>FASTBLD.LOG
:DONE
