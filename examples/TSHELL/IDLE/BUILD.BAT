@ECHO OFF
PATH=C:\BIN
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /Gsw /ASw /Zp /W3 /Od TSINPUT.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX LIBENTRY.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @TSINPUT.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /Zp /W3 /Od IDLEPROB.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @IDLEPROB.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
