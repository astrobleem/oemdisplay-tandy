@ECHO OFF
REM Isolated demo entry point for the existing C:\TANDY88 installation.
IF NOT EXIST C:\CD30\COMMDLG.DLL GOTO MISSING
IF NOT EXIST C:\CD30\CDTEST.EXE GOTO MISSING
IF NOT EXIST C:\TANDY88\RESERVE.COM GOTO MISSING
IF NOT EXIST C:\WINDOWS\WIN.COM GOTO MISSING
C:\TANDY88\RESERVE.COM
IF ERRORLEVEL 1 GOTO FAILED
C:
CD C:\CD30
C:\WINDOWS\WIN.COM /R CDTEST.EXE
GOTO END
:MISSING
ECHO Required CD30, TANDY88 reservation, or Windows files are missing.
ECHO See README.TXT. Windows was not started.
GOTO END
:FAILED
ECHO Video reservation failed. Windows was not started.
:END
