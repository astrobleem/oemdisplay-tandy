+++ b/SOURCE/tools/APPLY08.PY
@@ -0,0 +1,28 @@
+from pathlib import Path
+import hashlib,json,importlib.machinery
+P=Path(__file__).resolve().parents[1]
+proposal=json.loads((P/'data/PROPOSE.JSON').read_text())
+baseline=proposal['baseline'];groups=proposal['groups']
+def put(p,s):p.write_bytes(s.replace('\n','\r\n').encode('ascii'))
+source=P/'data/STARTER.JSON'
+assert hashlib.sha256(source.read_bytes()).hexdigest()==baseline['source_sha256']
+assert hashlib.sha256((P/'build/TANDY.DAT').read_bytes()).hexdigest()==baseline['dat_sha256']
+out=json.loads(source.read_text());chars={c['id']:c for c in out['characters']};qids={q['id'] for q in out['questions']};seen=set();changes=[]
+for cid,old,new,sid,qs in groups:
+    assert cid in chars and sid in proposal['source_urls']
+    for q in qs:
+        assert q in qids and (cid,q) not in seen and chars[cid]['answers'][q]==old,(cid,q)
+        seen.add((cid,q));chars[cid]['answers'][q]=new
+        changes.append({'character':cid,'question':q,'old':old,'new':new,'source_id':sid,'url':proposal['source_urls'][sid]})
+assert len(changes)==258 and len({c['character'] for c in changes})==21
+assert sum(c['old']==2 for c in changes)==255
+out['portrayal_policy']+=' Separate TANDI08 proposal3 experimental variant: 258 bounded source-backed changes; not promotion-ready. Some prior UNKNOWN cells are filled only by the explicit proposal.'
+put(P/'data/AUDIT08.JSON',json.dumps(out,indent=2)+'\n')
+db=importlib.machinery.SourceFileLoader('db',str(P/'tools/DBBUILD.PY')).load_module()
+loaded=db.load_source(P/'data/AUDIT08.JSON');blob=db.compile_source(loaded);db.validate_binary(blob)
+(P/'build/AUDIT08.DAT').write_bytes(blob)
+report={'status':'separate_experimental_variant','changes':changes,'changed_cells':len(changes),'characters':21,'unknown_fills':255,'baseline':baseline,'source_sha256':hashlib.sha256((P/'data/AUDIT08.JSON').read_bytes()).hexdigest(),'dat_sha256':hashlib.sha256(blob).hexdigest(),'deferred_semantic_issues':['artist means author or visual artist, not musician; Beethoven artist cell is deferred','Messi Asia association reset to UNKNOWN: Saudi Tourism ambassador campaign makes broad association ambiguous; no fabricated NO',
+        'A precise birthplace question is a future option only; current questions remain unchanged',
+        'Zeus water remains ambiguous because question includes water broadly; no invented NO','Poseidon conquest reset to UNKNOWN; broad territorial ambition is not established','Named adaptations and visual clothing refer to the supplied familiar portrayal','Missing broad factual coverage remains; performance is self-consistency, not accuracy'],'publication':'Default/UI TANDY.DAT remains unchanged; no canonical promotion.'}
+put(P/'data/AUDIT08.JSN',json.dumps(report,indent=2)+'\n')
+print(json.dumps({k:v for k,v in report.items() if k!='changes'},indent=2))
--- a/SOURCE/tools/EMULEASE.PY
+++ b/SOURCE/tools/EMULEASE.PY
@@ -0,0 +1,26 @@
+from contextlib import contextmanager
+from pathlib import Path
+import os,time
+if os.name=="nt":import msvcrt
+else:import fcntl
+LOCK=Path(os.environ['TANDI_LOCK'])
+@contextmanager
+def lease():
+    with LOCK.open('a+b') as f:
+        f.seek(0,2)
+        if f.tell()==0:f.write(b'0');f.flush()
+        deadline=time.monotonic()+60
+        while True:
+            f.seek(0)
+            try:
+                if os.name=="nt":msvcrt.locking(f.fileno(),msvcrt.LK_NBLCK,1)
+                else:fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)
+                break
+            except OSError:
+                if time.monotonic()>=deadline:raise TimeoutError('Shared emulator lock busy after 60 seconds')
+                time.sleep(1)
+        try:yield
+        finally:
+            f.seek(0)
+            if os.name=="nt":msvcrt.locking(f.fileno(),msvcrt.LK_UNLCK,1)
+            else:fcntl.flock(f,fcntl.LOCK_UN)
--- a/SOURCE/tools/WINQA.PY
+++ b/SOURCE/tools/WINQA.PY
@@ -0,0 +1,97 @@
+"""Private Windows fixture runner: owned media stays outside deliverables."""
+from pathlib import Path
+import hashlib,json,shutil,subprocess,sys,time,os
+import importlib.machinery
+lease=importlib.machinery.SourceFileLoader("emulease",str(Path(__file__).with_name("EMULEASE.PY"))).load_module().lease
+P=Path(__file__).resolve().parents[1]
+root=Path(os.environ['TANDI_PRIVATE'])
+MODES={'320x200x16':'TR53216.DRV','640x200x2':'TR56402.DRV','640x200x4':'TR56404.DRV'}
+def ini(path,section,key,value):
+    out=[];active=False;found=False
+    for line in path.read_text().splitlines():
+        if line.strip().startswith('['):
+            if active and not found:out.append(key+'='+value);found=True
+            active=line.strip().lower()=='['+section.lower()+']'
+        if active and '=' in line and line.split('=',1)[0].strip().lower()==key.lower():
+            out.append(key+'='+value);found=True
+        else:out.append(line)
+    if not found:
+        if not active:out.append('['+section+']')
+        out.append(key+'='+value)
+    path.write_bytes(('\r\n'.join(out)+'\r\n').encode('ascii'))
+def run(mode,tag,negative=False,sound=1):
+    dest=root/'native-results'/(mode+'-'+tag)
+    dest.mkdir(parents=True,exist_ok=False)
+    guest=dest/'guest';guest.mkdir();shutil.copytree(Path(os.environ['TANDI_WINDOWS']),guest/'WINDOWS')
+    shutil.copyfile(Path(os.environ['TANDI_RESERVE']),guest/'RESERVE.COM')
+    shutil.copyfile(Path(os.environ['TANDI_TRIAL7'])/MODES[mode],guest/'WINDOWS/SYSTEM/TRIAL.DRV')
+    shutil.copyfile(P/'src/TANDI.EXE',guest/'WINDOWS/TANDI.EXE')
+    data=bytearray((P/'build/TANDY.DAT').read_bytes())
+    if negative:data[-1]^=1
+    (guest/'WINDOWS/TANDY.DAT').write_bytes(data)
+    for k,v in [('display.drv','TRIAL.DRV'),('shell','TANDI.EXE'),('fonts.fon','CGASYS.FON'),('fixedfon.fon','CGAFIX.FON'),('oemfonts.fon','CGAOEM.FON')]:ini(guest/'WINDOWS/SYSTEM.INI','boot',k,v)
+    for k,v in [('Test','1'),('TestTarget','Mario'),('TestExit',str(list(MODES).index(mode)+1)),('Sound',str(sound))]:ini(guest/'WINDOWS/WIN.INI','TANDINATOR',k,v)
+    for k in ['run','load']:ini(guest/'WINDOWS/WIN.INI','windows',k,'')
+    start='''@ECHO OFF
+RESERVE > RESERVE.TXT
+IF ERRORLEVEL 1 GOTO BAD
+SET PATH=C:\\WINDOWS;Z:\\
+SET TEMP=C:\\WINDOWS\\TEMP
+CD WINDOWS
+WIN /R
+CD \\
+ECHO RETURNED > RETURNED.TXT
+GOTO DONE
+:BAD
+ECHO RESERVE_FAILED > RETURNED.TXT
+:DONE
+EXIT
+'''
+    (guest/'START.BAT').write_bytes(start.replace('\n','\r\n').encode())
+    conf=f'''[sdl]
+fullscreen=false
+output=surface
+[dosbox]
+machine=tandy
+memsize=1
+captures={dest/'captures'}
+[cpu]
+core=normal
+cputype=8086_prefetch
+cycles=fixed 25000
+fpu=false
+[dos]
+xms=false
+ems=false
+umb=false
+[mixer]
+nosound=true
+[speaker]
+tandy=on
+[autoexec]
+@echo off
+mount C "{guest}"
+C:
+START.BAT
+'''
+    (dest/'RUN.CNF').write_bytes(conf.replace('\n','\r\n').encode())
+    si=None;flags=0
+    if os.name=='nt':
+        si=subprocess.STARTUPINFO();si.dwFlags|=subprocess.STARTF_USESHOWWINDOW;si.wShowWindow=0;flags=subprocess.CREATE_NO_WINDOW
+    started=time.monotonic()
+    with lease(),(dest/'HOST.LOG').open('w') as out:
+        r=subprocess.run([os.environ['TANDI_DOSBOX'],'-nopromptfolder','-conf',str(dest/'RUN.CNF')],stdout=out,stderr=subprocess.STDOUT,timeout=180,startupinfo=si,creationflags=flags)
+    log=(guest/'TANDI.LOG').read_text() if (guest/'TANDI.LOG').exists() else ''
+    sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+    result={'mode':mode,'tag':tag,'negative':negative,'sound_pref':sound,'returncode':r.returncode,'seconds':time.monotonic()-started,'log':log,'exe_sha256':sha(P/'src/TANDI.EXE'),'database_sha256':sha(guest/'WINDOWS/TANDY.DAT'),'driver_sha256':sha(guest/'WINDOWS/SYSTEM/TRIAL.DRV'),'returned':(guest/'RETURNED.TXT').read_text() if (guest/'RETURNED.TXT').exists() else None}
+    (dest/'RESULT.JSN').write_text(json.dumps(result,indent=2))
+    print(json.dumps({k:v for k,v in result.items() if k!='log'},indent=2),flush=True)
+    assert r.returncode==0 and result['returned'] and 'RETURNED' in result['returned']
+    assert 'COMPLETE=1' in log
+    if negative:assert 'APP_ERROR=1' in log and 'BAD_DAT_EXIT_ONLY=1' in log
+    else:
+        for key in ['TARGET_SUCCESS','BUSY_INPUT_IGNORED','DOUBLE_CLICK_STAYS_SUCCESS','HELD_KEY_IGNORED','SECOND_REJECTION_NO_GATE','CAP_ALL_CANDIDATES_REACHABLE','SOUND_PREF_SAVED','SOUND_HELD_KEY_IGNORED','GATE_RESTART']:
+            assert key+'=1' in log,key
+        assert 'CAP_GATE_COUNT=1' in log and 'ERRORS=0' in log and 'WINFLAGS=64' in log
+    return result
+if __name__=='__main__':run(sys.argv[1],sys.argv[2],len(sys.argv)>3 and sys.argv[3]=='bad',int(sys.argv[4]) if len(sys.argv)>4 else 1)
