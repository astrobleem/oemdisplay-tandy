--- a/SOURCE/tests/ROSTER.C
+++ b/SOURCE/tests/ROSTER.C
@@ -0,0 +1,27 @@
+/* Truthful full-roster traversal using the shipped ENGINE.C and DB.C. */
+#include <stdio.h>
+#include "../src/TANDI.H"
+static TDB d;static ENGINE e;static U8 row[TD_ROW];
+int main(int argc,char **argv){
+    int c,q,guess,first,miss,cap,unknown,rejects,i;char name[40];
+    if(argc!=2||!db_open(&d,argv[1]))return 2;
+    printf("index,name,questions,cap,first_guess,first_miss,rejections,unknown\n");
+    for(c=0;c<(int)d.nc;c++){
+        if(!db_row(&d,c,row)||!db_name(&d,c,name))return 3;
+        unknown=0;for(i=0;i<(int)d.nq;i++)unknown+=db_value(row,i)==2;
+        eng_reset(&e,&d);first=-1;miss=cap=rejects=0;
+        for(i=0;i<(int)d.nc+(int)d.nq+1;i++){
+            guess=eng_confident(&e,&d);
+            if(!guess){q=eng_choose(&e,&d);guess=q<0;}
+            if(guess){
+                if(e.best<0)return 4;
+                if(first<0){first=e.best;miss=first!=c;cap=e.turn>=25;}
+                if(e.best==c)break;
+                eng_reject(&e,&d);rejects++;
+            }else if(!eng_answer(&e,&d,db_value(row,q)))return 5;
+        }
+        if(e.best!=c)return 6;
+        printf("%d,%s,%d,%d,%d,%d,%d,%d\n",c,name,e.turn,cap,first,miss,rejects,unknown);
+    }
+    db_close();return 0;
+}
--- a/SOURCE/tests/ROSTER.PY
+++ b/SOURCE/tests/ROSTER.PY
@@ -0,0 +1,19 @@
+"""Compile the actual engine/loader; record every target twice and compare."""
+from pathlib import Path
+import csv,hashlib,io,json,os,subprocess,sys
+P=Path(__file__).resolve().parents[1]
+cc=os.environ.get('CC','gcc')
+exe=P/'build/ROSTER.EXE'
+subprocess.run([cc,'-std=c89','-O2','-Wall','-Wextra','-pedantic','-I'+str(P/'src'),'-x','c',str(P/'tests/ROSTER.C'),str(P/'src/ENGINE.C'),str(P/'src/DB.C'),'-o',str(exe)],check=True)
+db=Path(sys.argv[1]) if len(sys.argv)>1 else P/'build/TANDY.DAT'
+tag=sys.argv[2] if len(sys.argv)>2 else 'CURRENT'
+runs=[subprocess.check_output([str(exe),str(db)]) for _ in range(2)]
+assert runs[0]==runs[1],'Nondeterministic traversal'
+rows=list(csv.DictReader(io.StringIO(runs[0].decode())))
+def cohort(rs):
+ return {'characters':len(rs),'cap_hits':sum(int(r['cap']) for r in rs),'mean_questions':sum(int(r['questions']) for r in rs)/len(rs),'first_guess_misses':sum(int(r['first_miss']) for r in rs),'mean_unknown':sum(int(r['unknown']) for r in rs)/len(rs),'unknown_range':[min(int(r['unknown']) for r in rs),max(int(r['unknown']) for r in rs)],'total_rejections':sum(int(r['rejections']) for r in rs)}
+report={'database_sha256':hashlib.sha256(db.read_bytes()).hexdigest(),'engine_sha256':hashlib.sha256((P/'src/ENGINE.C').read_bytes()).hexdigest(),'loader_sha256':hashlib.sha256((P/'src/DB.C').read_bytes()).hexdigest(),'repeat_exact':True,'truth_policy':'Use DAT value verbatim; 2 remains unknown. Confirm only intended target; reject every other guess.','all':cohort(rows),'original_128':cohort(rows[:128]),'added':cohort(rows[128:]) if len(rows)>128 else None}
+(P/'evidence'/('ROSTER-'+tag+'.CSV')).write_bytes(runs[0])
+put=lambda p,s:p.write_bytes(s.replace('\n','\r\n').encode('ascii'))
+put(P/'evidence'/('ROSTER-'+tag+'.JSN'),json.dumps(report,indent=2)+'\n')
+print(json.dumps(report,indent=2))
