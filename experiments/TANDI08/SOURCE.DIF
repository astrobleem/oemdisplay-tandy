--- a/SOURCE/tests/AUDIT08.PY
+++ b/SOURCE/tests/AUDIT08.PY
@@ -0,0 +1,29 @@
+"""Exact proposal delta and repeatable compiled variant; not factual proof."""
+from pathlib import Path
+import hashlib,json,importlib.machinery
+P=Path(__file__).resolve().parents[1]
+r=json.loads((P/'data/PROPOSE.JSON').read_text());a=json.loads((P/'data/STARTER.JSON').read_text());b=json.loads((P/'data/AUDIT08.JSON').read_text())
+assert hashlib.sha256((P/'data/STARTER.JSON').read_bytes()).hexdigest()==r['baseline']['source_sha256']
+assert hashlib.sha256((P/'build/TANDY.DAT').read_bytes()).hexdigest()==r['baseline']['dat_sha256']
+expected={}
+for cid,old,new,sid,qs in r['groups']:
+ for q in qs:
+  assert (cid,q) not in expected and sid in r['source_urls']
+  expected[cid,q]=(old,new)
+assert len(expected)==258 and len({c for c,q in expected})==21
+assert a['questions']==b['questions'] and [c['id'] for c in a['characters']]==[c['id'] for c in b['characters']]
+actual={}
+for ca,cb in zip(a['characters'],b['characters']):
+ assert ca['name']==cb['name']
+ for q,old in ca['answers'].items():
+  new=cb['answers'][q]
+  if new!=old:actual[ca['id'],q]=(old,new)
+assert actual==expected
+assert a['characters'][:128]==b['characters'][:128]
