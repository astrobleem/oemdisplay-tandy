; PRIVATE TRIAL 4 COLOR: frozen synchronous optimized driver.
; Existing staging markers do not validate this modified trial source.
[data]
Version = "3.0"
[disks]
a = ., "Tandy EX/HX TRIAL 4 COLOR 3204", OEMSETUP.INF
[display]
TR43204 = a:TR43204.DRV, "Tandy EX/HX 320x200 4 colors (TRIAL 4 COLOR)", "200,96,48", a:CGA.GR2, a:CGALOGO.LGO,,,, a:TNDYLOGO.RLE
[sysfonts]
a:CGASYS.FON, "CGA System Font", "200,96,48"
[fixedfonts]
a:CGAFIX.FON, "CGA Fixed System Font", "200,96,48"
[oemfonts]
a:CGAOEM.FON, "CGA Terminal Font (USA/Europe)", "200,96,48", 1
