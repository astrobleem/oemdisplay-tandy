@ECHO OFF
PATH=C:\BIN
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /Gw /AS /W3 /Oat CUBE.C CUBECORE.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /MAP /NOE /NOD @CUBE.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Oat CUBECTL.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /MAP /NOE /NOD @CUBECTL.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
