--- UI04/tests/UITEST.PY
+++ AUDIT05/tests/UITEST.PY
@@ -2,12 +2,13 @@
 """Read-only UI04 regression checks against actual emulator screenshots."""
 from pathlib import Path
 from PIL import Image
-import hashlib,json
+import hashlib,json,argparse
 P=Path(__file__).resolve().parents[1]
+ap=argparse.ArgumentParser();ap.add_argument('--runtime-tag',default='-ui04');args=ap.parse_args()
 sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
 rows=[]
 for mode in ['320x200x16','640x200x2','640x200x4']:
- d=P/'evidence'/('art-'+mode+'-ui04');r=json.loads((d/'RESULT.JSON').read_text())
