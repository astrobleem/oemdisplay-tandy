-CL /nologo /c /G0 /Gw /AS /W3 /O /DWIN16 TANDI.C DB.C ENGINE.C OBSERVE.C DEMO.C TDSOUND.C > BUILD.LOG
+CL /nologo /c /G0 /Gw /AS /W3 /O /DWIN16 TANDI.C DB.C ENGINE.C OBSERVE.C DEMO.C TDSOUND.C LEARN.C SHAPIN.C > BUILD.LOG
