 PRE='\n#include <stdio.h>\n#include <string.h>\n#include "TANDI.H"\n#include "OBSERVE.H"\nstatic TDHISTORY history; static TDEXPLAIN explanation; static int explaining,explainpage;\ntypedef long LONG; typedef unsigned long DWORD; typedef unsigned UINT,WORD; typedef int HWND;\ntypedef struct {int left,top,right,bottom;} RECT;\n#define FAR\n#define PASCAL\n#define FALSE 0\n#define LOWORD(x) ((x)&65535)\n#define HIWORD(x) (((x)>>16)&65535)\n#define VK_ESCAPE 27\n#define VK_F1 112\n#define VK_F2 113\n#define VK_TAB 9\n#define VK_SHIFT 16\n#define VK_RETURN 13\n#define VK_SPACE 32\n#define WM_PAINT 1\n#define WM_TIMER 2\n#define WM_ACTIVATEAPP 3\n#define WM_MOUSEMOVE 4\n#define WM_LBUTTONDOWN 5\n#define WM_KEYDOWN 6\n#define WM_DESTROY 7\n#define WM_CLOSE 8\n#define lstrcpy strcpy\nstatic TDB db; static ENGINE engine;\nstatic int window=1,screenw=320,screenh=200,sx=1,state,focus,debug,help,busy,testmode,active,testinside,artblits,logfile=-1,closed;\nstatic RECT buttons[6]; static int ids[6],nb;static char labels[6][24],question[80],name[40];\nstatic char *answers[5]={"YES","PROBABLY","DON\'T KNOW","PROBABLY NOT","NO"};\nstatic DWORD answerms,selectms;\nstatic int panelleft(void){return 104*sx;}\nstatic void layout(void);\nstatic void refresh(void){layout();}\nstatic void questionrefresh(int f){layout();}\nstatic void busyfooter(void){}\nstatic DWORD now; static DWORD GetTickCount(void){return now;}\nstatic void metric(char *k,long v){}\nstatic void InvalidateRect(HWND w,RECT *r,int b){}\nstatic void UpdateWindow(HWND w){}\nstatic int GetKeyState(int k){return 0;}\nstatic void SendMessage(HWND w,UINT m,WORD p,LONG l){if(m==WM_CLOSE)closed++;}\nstatic void draw(HWND w){}\nstatic void testtick(void){}\nstatic void look(int x,int y){}\nstatic void debugupdate(void){}\nstatic void artfree(void){}\nstatic void _lclose(int f){}\nstatic void PostQuitMessage(int n){}\nstatic LONG DefWindowProc(HWND w,UINT m,WORD p,LONG l){return 0;}\n\n#define VK_F3 114\n#define VK_F4 115\n#define WM_KILLFOCUS 9\n#define WM_ACTIVATE 10\n#define WM_QUERYENDSESSION 11\n#define WM_ENDSESSION 12\n#define TD_SND_REVEAL 1\n#define TD_SND_VICTORY 2\n#define TD_SND_WRONG 3\nstatic int animframe=-1,animticks,idleticks,pending,timerok=1,animredraws,computeticks;\nstatic int tickinside,rejectphase,capoffered,soundpref=1,soundsupported=1,settingssaved=1,soundenabled=1,soundstops;\nstatic DWORD inputready,computepeak;\nstatic void animset(int f){animframe=f;}\nstatic void KillTimer(int w,int t){}\nstatic int TdSoundBegin(int w,int c,DWORD t){return 1;}\nstatic void TdSoundStop(int w){soundstops++;}\nstatic void TdSoundTick(int w,DWORD t){}\nstatic int TdSoundEnabled(void){return soundenabled;}\nstatic void TdSoundEnable(int v){soundenabled=v;}\nstatic int profilevalue=1,profileok=1;\nstatic int GetProfileInt(char*a,char*b,int d){return profileok?profilevalue:d;}\nstatic int WriteProfileString(char*a,char*b,char*c){if(profileok)profilevalue=c[0]==49;return profileok;}\n'
 POST='\nstatic int fails=0,checks=0;\n#define CHECK(x) do{checks++;if(!(x)){fails++;printf("FAIL %d %s\\n",__LINE__,#x);}}while(0)\nstatic void tick(void){now+=110;WndProc(1,WM_TIMER,2,0);}\nstatic void ready(void){while(pending)tick();now+=230;}\nstatic void reset(void){busy=pending=0;inputready=0;active=1;eng_reset(&engine,&db);obs_reset(&history);capoffered=0;state=1;next();ready();}\nint main(int argc,char**argv){int turn,old,stops;\n if(argc!=2||!db_open(&db,argv[1]))return 2;\n reset();turn=engine.turn;WndProc(1,WM_KEYDOWN,VK_RETURN,1L<<30);CHECK(engine.turn==turn);\n WndProc(1,WM_KEYDOWN,VK_RETURN,0);CHECK(engine.turn==turn+1&&!pending&&!busy);\n turn=engine.turn;WndProc(1,WM_KEYDOWN,VK_RETURN,0);CHECK(engine.turn==turn);\n WndProc(1,WM_LBUTTONDOWN,0,210|(95L<<16));CHECK(engine.turn==turn);\n ready();CHECK(state==1&&!busy&&!pending);\n reset();while(engine.turn<24){eng_choose(&engine,&db);obs_answer(&history,&engine,&db,2);}next();ready();\n WndProc(1,WM_LBUTTONDOWN,0,210|(150L<<16));CHECK(!pending&&engine.turn==25);\n WndProc(1,WM_LBUTTONDOWN,0,210|(150L<<16));CHECK(!pending);\n while(pending)tick();old=engine.best;CHECK(state==2);\n WndProc(1,WM_LBUTTONDOWN,0,210|(150L<<16));CHECK(!engine.rejected[old]);\n now+=230;WndProc(1,WM_LBUTTONDOWN,0,210|(130L<<16));CHECK(state==3);\n WndProc(1,WM_LBUTTONDOWN,0,210|(130L<<16));CHECK(state==3);\n now+=230;WndProc(1,WM_LBUTTONDOWN,0,210|(130L<<16));CHECK(state==1&&!pending);\n stops=soundstops;WndProc(1,WM_ACTIVATEAPP,0,0);CHECK(soundstops>stops);turn=animticks;tick();CHECK(animticks==turn);\n WndProc(1,WM_ACTIVATEAPP,1,0);ready();CHECK(!pending);\n stops=soundstops;WndProc(1,WM_KILLFOCUS,0,0);CHECK(soundstops>stops);\n stops=soundstops;CHECK(WndProc(1,WM_QUERYENDSESSION,0,0)==1);CHECK(soundstops>stops);\n timerok=0;reset();CHECK(!busy&&!pending&&state==1);\n timerok=1;reset();WndProc(1,WM_KEYDOWN,VK_RETURN,0);CHECK(!pending);closed=0;\n WndProc(1,WM_LBUTTONDOWN,0,280|(189L<<16));CHECK(closed==1);\n\n reset();turn=engine.turn;closed=0;\n WndProc(1,WM_KEYDOWN,VK_F1,0);CHECK(help==1);\n WndProc(1,WM_KEYDOWN,VK_ESCAPE,0);CHECK(!help&&!debug&&!closed&&engine.turn==turn);\n now+=230;WndProc(1,WM_KEYDOWN,VK_F2,0);CHECK(debug==1&&nb==3&&ids[0]==91);\n WndProc(1,WM_KEYDOWN,VK_ESCAPE,0);CHECK(!debug&&!closed);\n now+=230;WndProc(1,WM_KEYDOWN,VK_F2,0);act(91);CHECK(debug==2);\n WndProc(1,WM_KEYDOWN,VK_ESCAPE,0);CHECK(!debug&&!closed);\n reset();while(engine.turn<25){eng_choose(&engine,&db);obs_answer(&history,&engine,&db,2);}nextcompute();now+=230;old=engine.best;\n act(21);CHECK(state==5&&!pending&&engine.rejected[old]);turn=engine.turn;old=engine.best;\n tick();tick();tick();CHECK(state==5&&!pending&&engine.turn==turn&&engine.best==old);\n now+=230;WndProc(1,WM_KEYDOWN,\'N\',0);CHECK(state==5&&!engine.rejected[old]);\n act(30);CHECK(!pending&&state==2);ready();CHECK(state==2&&engine.turn==25&&engine.best==old);\n act(21);CHECK(state==2&&capoffered);now+=230;act(10);ready();CHECK(state==1&&engine.turn==0&&!engine.rejected[old]);\n db.error=1;state=4;layout();CHECK(nb==1&&ids[0]==99);db.error=0;\n /* No cap or lost candidate: every remaining guess remains deliberately reachable. */\n reset();while(engine.turn<25){eng_choose(&engine,&db);obs_answer(&history,&engine,&db,2);}nextcompute();now+=230;turn=0;\n old=0;while(state==2){act(21);turn++;if(state==5){old++;now+=230;act(30);}ready();}CHECK(old==1);\n CHECK(state==4&&turn==db.nc&&engine.turn==25);\n\n reset();soundpref=1;profileok=1;WndProc(1,WM_KEYDOWN,VK_F3,0);CHECK(!soundpref&&!soundenabled&&profilevalue==0&&settingssaved);\n WndProc(1,WM_KEYDOWN,VK_F3,1L<<30);CHECK(!soundpref);\n profileok=0;WndProc(1,WM_KEYDOWN,VK_F3,0);CHECK(soundpref&&soundenabled&&!settingssaved&&profilevalue==0);\n profileok=1;profilevalue=0;soundsettings();CHECK(!soundpref&&!soundenabled);\n soundsupported=0;CHECK(!strcmp(soundfooter(),"F1 HELP F2 DEBUG NO SOUND"));\n soundsupported=1;settingssaved=1;CHECK(!strcmp(soundfooter(),"F1 HELP F2 DEBUG F3 SOUND OFF"));\n profileok=0;soundsettings();CHECK(soundpref&&soundenabled);\n settingssaved=0;CHECK(!strcmp(soundfooter(),"F1 HELP F2 DEBUG SOUND UNSAVED"));\n reset();while(engine.turn<25){eng_choose(&engine,&db);obs_answer(&history,&engine,&db,2);}next();ready();WndProc(1,WM_KEYDOWN,VK_F4,0);CHECK(explaining&&explanation.valid&&explanation.count==25);ready();act(94);CHECK(explainpage==1);ready();act(93);CHECK(explainpage==0);WndProc(1,WM_KEYDOWN,VK_ESCAPE,0);CHECK(!explaining&&state==2);\n printf("UI guards/lifecycle: %d checks, %d failures\\n",checks,fails);db_close();return fails!=0;\n}\n'
+# These legacy game checks run with demo disabled. Actual demo/input handlers
+# are qualified by DEMO10 and native /J plus production /S fixtures separately.
+PRE+='''
+#include "DEMO.H"
+#define NULL 0
+#define WA_INACTIVE 0
+#define WM_CANCELMODE 40
+#define WM_SETCURSOR 41
+static TDDEMO demonstration;
+static int demoAuto,demoArmed,demoDrain,demoQA,demoPeer,demoReturning;
+static DWORD demoWelcome;
+static int demoInput(UINT m,WORD w,LONG l){return 0;}
+static void demoCleanup(int r){}
+static void demoQATick(void){}
+static void demoDrainTick(void){}
+static void demoPulse(void){}
+static int demoStart(void){return 0;}
