--- a/SOURCE/BUILD10.TXT
+++ b/SOURCE/BUILD10.TXT
@@ -0,0 +1,32 @@
+TANDI10 REPRODUCTION AND LIMITS
+SOURCE is derived from immutable TANDI09 ZIP da14fd8c55ca68782239ded222b60f05735b5a9aaadd18a2b3c324fdcea1b9af.
+evidence/BASE10.JSN pins original source bytes. Engine/loader/data/art/sound stay
+unchanged. SOURCE.DIF and TSHELL.DIF describe first-party source changes.
+Use your licensed C6/Windows inputs; they are not redistributed. Mount toolchain
+as C: and SOURCE/src as D:, run BUILD.BAT (/G0 /Gw /AS). Check BUILD.OK, BUILD.LOG.
+Mount SOURCE/tests as D: and run BUILD10.BAT to build LAUNCH10.EXE, the first-party
+fixture launcher. Win3 boot shell accepts a filename; LAUNCH10 supplies real args.
+Mount TSHELL as D:, run BUILD.BAT for the optional shell and BUILDQA.BAT for TS10QA.
+Modern host checks: tests/CHECK09.PY, tests/DEMO10.PY, tests/DBTEST.PY,
+tools/AUDIT.PY, TSHELL/TESTS/CONFIG/TESTCFG.C with portable SCFGCORE.C.
+Windows GCC sanitizer coverage is skipped; native Win16 coverage is separate.
+
+Native tools/WINQA10.PY uses your owned private copies with explicit environment:
+TANDI_PRIVATE (new output parent), TANDI_WINDOWS (owned Windows directory),
+TANDI_DOSBOX, TANDI_RESERVE, TANDI_TRIAL7 (qualified NEW drivers), TANDI_LOCK.
+All collaborators must use the same cooperative emulator lock. Acquisition is
+bounded at 60 seconds; run timeout 180 seconds. Never remove another owner's lock.
+Example: WINQA10.PY 320x200x16 fresh-tag ok 1 "/J"
+Repeat 640x200x2; use "/J /C" for cues in 640x200x4. Saved-off: ok 0 "/J /C".
+Production wake: WINQA10.PY 320x200x16 fresh-prod ok 1 "/S" 1
+Cases 1 key,2 delayed double click,3 foreign capture,4 foreign focus/cursor,
+5 close,6 end-session query. Only our own native windows receive fixture messages.
+Normal legacy gameplay: WINQA10.PY MODE fresh-game ok 1 "/T".
+Bad DAT: WINQA10.PY 320x200x16 fresh-bad bad 1 "/T".
+tools/TSQA10.PY MODE fresh-shell tests the fourth-saver preview protocol.
+The /J fixture advances deadlines for bounded native coverage; DEMO10.C tests
+actual early/late pacing and wraparound separately. Timings are uncalibrated fixed
+DOSBox cycles, not physical 8088 benchmarks or a human play study.
+Historical QA08/QA09 and first-checkpoint source/evidence retain their provenance.
+QA10/NATIVE10/ART10/SHELL10 are the current qualification; never treat historical
+native captures as evidence for the new EXE. Private guests/drivers are excluded.
--- a/SOURCE/PLAN10.TXT
+++ b/SOURCE/PLAN10.TXT
@@ -0,0 +1,21 @@
+NEXT: OPT-IN LEARNING DESIGN, NOT IMPLEMENTED
+1. Default off. Keep the base DAT immutable and allow an explicitly unlearned
+   game. The demo, replay fixture and ordinary guessing never commit learning.
+2. Start with user-confirmed identity and base UNKNOWN cells only. Before save,
+   show exact questions, reported answer strengths and named character edition.
+   One game is a report, not independent factual proof; repeating it is not proof.
+3. Store a separate bounded overlay with base hash/revision, stable character and
+   question IDs, local session provenance, tentative reports and visible conflicts.
+   Leave conflicting cells inactive; permit per-cell and whole-overlay reset.
+   New roster entries and changing known facts are later, separate design choices.
+4. Validate complete lengths, IDs, dimensions, values, version, checksum and base
+   pin before use. Corrupt, stale or oversized files fall back to unlearned mode.
+   Save via validated temporary replacement and recoverable prior copy; surface
+   an explicit save failure. Define and test Win3/DOS rename failure behavior.
+5. Before runtime implementation, review how tentative overlay facts affect the
+   unchanged engine's weights and confidence. Test truthful and exact Claude noisy
+   paths against pinned standard/AUDIT baselines. Do not force better metrics by
+   inventing facts or changing thresholds. Unknown and conflicting facts stay honest.
+6. Only after that policy and review UI are approved, implement bounded Win16
+   storage/overlay access, input guards and failure paths. No background teaching,
+   automatic identity inference, uploads or changes to installed shell/defaults.
--- a/SOURCE/QA10.TXT
+++ b/SOURCE/QA10.TXT
@@ -0,0 +1,54 @@
+TANDI10 / APP 0.3.7 QUALIFICATION - LOCAL ONLY
+Derived from immutable TANDI09. Engine, loader, observation logic, original art,
+sound module, standard DAT and separate AUDIT08 DAT remain byte-identical.
+Dedicated /D or /S is quiet unless /C AND saved sound preference opt into cues.
+/A arms only an untouched welcome screen after 60 seconds; no midgame takeover.
+First wake blanks and stops sound before controls; held/repeated input, chars,
+system keys and mouse double clicks drain before return/closure. No settings,
+answer history, teaching, learning or other app's input is saved/generated.
+Foreground/capture/focus loss stops the demo; foreign cursor/capture are preserved.
+
+19 exact-EXE native runs passed: three demo modes with eight authored targets;
+three fourth-saver protocol previews; saved-off /C; eight real /S launch cases
+(held key, delayed double click, foreign capture/focus/cursor, close and shutdown);
+three normal games including cap continuation, settings fallback and repeated
+input; one corrupt DAT. Every run is a private real-mode Windows 3.0 guest with
+8086_prefetch, 640 KB, no FPU/XMS/EMS/UMB and fixed uncalibrated 25000 cycles.
+Owned native messages exercise the handlers. /J advances deadlines for bounded
+coverage; host checks test no early step, wraparound and no late catch-up.
+This is not physical-hardware timing or a human play study.
+
+Host: 49 normal UI checks; 59 sound/lease/failure cases; 53 DAT compiler tests;
+164 fourth-saver config/path/rollback checks; 64 demo games per DAT repeated byte
+exact across eight characters; whole-roster explanations/counts and 256-answer
+boundaries unchanged. C6 /G0 /Gw /AS builds are warning-free. NE audit finds no
+unsupported/FPU opcode, with scope/embedded-data exclusions in AUDIT.JSON.
+ART10 verifies translated cabinet/face/logo indices, bounded moving eyes, six
+positions, all-black interludes and all-black wake frames in all three modes.
+Moving pixels and black intervals do not power down a CRT or guarantee burn-in
+protection. Use monitor power-off for long absences.
+
+Verified all 37 TSHELL build inputs plus README against current connected main.
+The optional build adds SC_TANDINATOR/TandinatorProgram, absolute path validation,
+its own radio choice, TANDI module duplicate suppression, TandyTandinatorSaver
+preview/close and Hold gates. Starfield options remain in their own section.
+No other saver path is substituted. Native TS10QA includes actual control source;
+the first-party input DLL is unchanged. Physical Hold/hook behavior is not claimed.
+
+Independently confirmed original Claude harness: 31 standard versus 36 AUDIT08
+two-wrong final failures (225 versus 220 solved); 25 common, 11 new, 6 rescues.
+Truthful first misses improve 23 to 19; both eventually solve 256/256 truthful
+games. Adaptive questions can flip different facts under the same policy.
+This agent did not locally run the exact original Claude harness; provenance
+is the parent independent verifier in NOISE09.JSN. Exploratory first-miss checks
+use a separate policy, labelled accordingly. AUDIT08 remains experimental.
+
+Qualification caught and corrected fixture focus/underlay/cursor/opt-in issues
+and a teardown class-cursor edge. Intermediate captures are not final evidence.
+NATIVE10/ART10/SHELL10 bind exact final bits; historical QA08/QA09 retain history.
+No private OS/compiler/emulator/driver payload, installed shell/INI/default change,
+CF write, publication, merge, learning, Ask Two, undo or threshold change.
+PLAN10 describes the next opt-in learning design; it is not implemented.
+
+FINAL EXE SHA256: 42ea5a1381e819283ef7ac1f781f2be307e9e3f8345634f9a0e9c14f4111b3db
+OPTIONAL SHELL SHA256: 5fddc1b37c600ab8e431a70765c6cf769e6ec0cd04212112c02ce51989389e85
--- a/SOURCE/README.TXT
+++ b/SOURCE/README.TXT
@@ -1,35 +1,42 @@
-TANDINATOR 0.3.6 - LOCAL FIRST CHECKPOINT (TANDI09)
-Think of a character in ROSTER.TXT using its named character edition.
-App version is 0.3.6; standard roster revision remains 0.3.2.
-F1 Help. F2 Diagnostics warns before names. F3 toggles sound.
-F4 or HOW I KNEW on a guess opens scored clues against the real runner-up.
-PREV/NEXT shows every recorded answer, strongest score differences first.
-Positive clues favor the guess relative to that other name; negative clues
-favor the other name. Neutral or UNKNOWN clues do not establish a distinction.
-DAT facts are stored game data, not certified truth. A score margin is not
-proof of identity, and does not rule out a lower-ranked name.
-Leading means unrejected names within 24 score points of the current leader.
-The displayed denominator counts unrejected names. The leading count can rise;
-other names stay eligible. Only an explicitly rejected guess leaves eligibility.
-An immediate new guess plays REVEAL; a new question queues WRONG after work.
-No decorative computation wait was added. Input guard remains 220 ms.
-F3 is stored in WIN.INI [TANDINATOR] Sound; game answers are not saved.
-NO SOUND is unsupported; SOUND OFF is your preference. SOUND UNSAVED warns
-that the current preference could not be written. Escape closes an overlay
-first; Escape elsewhere and EXIT close the app. Held/repeated inputs are guarded.
-After the first rejected guess at question 25 choose Continue, Restart or Exit.
-Further rejections advance; all candidates remain reachable.
-If TANDY.DAT cannot be read, exit and replace it beside this EXE, then restart.
-INSTALL.BAT copies EXE,DAT,roster and README and refuses existing files.
-Start through your existing guarded WindowsXT launcher; no launcher bypass.
-RUN uses the unchanged standard DAT. AUDIT08 stays separate and experimental.
-Independent original-harness verification confirms a two-wrong regression:
-standard: 225 solved / 31 final failures; AUDIT08: 220 solved / 36 failures.
-This differs from truthful FIRST-GUESS misses: standard 23 / AUDIT08 19.
-Two-flip policy starts at question 4; flips first two non-UNKNOWN facts via 4-v;
-rejects wrong guesses, continues guesses after 25, and fails on a wrong guess
-after 10 earlier rejections or no candidates. See QA09.TXT and NOISE09.JSN.
-AUDIT08 remains experimental. Both DATs eventually solve 256/256 truthful games.
-The same flip rule may flip different facts due to adaptive question selection.
-No Ask Two, reverse, learning, attract mode, vocal cues or canonical promotion.
-This is a local copy-only review kit; no publication or physical hardware claim.
+TANDINATOR 0.3.7 - LOCAL DEMO REVIEW (TANDI10)
+App version 0.3.7. Standard roster revision remains 0.3.2.
+RUN uses the unchanged standard DAT; AUDIT08 stays separate and experimental.
+Start Windows through your existing guarded WindowsXT launcher.
+Keep this trial beside its DAT in a NEW DOS-compatible folder such as C:\TD037.
+Program Manager File-Run: C:\TD037\TANDI.EXE
+For the dedicated quiet demonstration: C:\TD037\TANDI.EXE /D
+For optional cues: C:\TD037\TANDI.EXE /D /C
+/C plays cues only when your saved F3 preference is also on. Demo never writes it.
+/S is the dedicated saver-compatible alias; both exit on the first wake gesture.
+For welcome-only idle opt-in: C:\TD037\TANDI.EXE /A
+It arms once after 60 seconds on an untouched welcome screen. Input disarms it.
+It does not replace an active game. Wake returns to a fresh welcome screen.
+Mouse movement, button or key input blanks the demo and stops its sound.
+Held gestures drain before closure/return; mouse drainage includes the system
+double-click interval, with a minimum 220 ms quiet interval. Repeats, chars and
+system keys are consumed. The waking F3 cannot alter your saved preference.
+The demo answers from the actual DAT and engine, using eight authored characters.
+It moves original artwork/eyes, shows reveals and uses full black interludes.
+Movement and black interludes are NOT monitor power management and do not
+guarantee protection from CRT burn-in. Turn off the monitor for long absences.
+
+Normal game: think of someone in ROSTER.TXT using its named character edition.
+F1 Help. F2 Diagnostics warns before names. F3 toggles and stores sound in
+WIN.INI [TANDINATOR] Sound. NO SOUND means unsupported; SOUND OFF is your choice.
+F4 or HOW I KNEW on a guess shows actual signed score clues against the runner-up.
+Unknown, neutral and conflicting clues remain visible. A guess is not proof.
+Leading counts unrejected names within 24 points of the current leader. The
+denominator counts all unrejected names. Other names stay eligible; counts rise.
+The first rejected guess after question 25 offers Continue/Restart/Exit once;
+further rejections advance while keeping all candidates reachable.
+Game answers and demonstrations are not saved. No teaching/learning is enabled.
+If DAT cannot be read, exit, replace it beside the EXE, then restart.
+INSTALL.BAT copies only app/data/docs and refuses existing files. It is optional.
+
+The original Claude harness independently confirms 31 standard versus 36 AUDIT08
+final failures with two wrong answers (225 versus 220 solved). Truthful first
+misses improve 23 to 19; both eventually solve all 256 truthful games. Adaptive
+questions can flip different facts under the same flip rule. No AUDIT08 promotion.
+The separate optional TSHELL build registers a true fourth saver; see its README.
+This kit changes no installed shell/INI/defaults. No CF write, publication, merge,
+physical-hardware claim, Ask Two, reverse mode, vocal cue or threshold change.
--- a/SOURCE/src/BUILD.BAT
+++ b/SOURCE/src/BUILD.BAT
@@ -3,7 +3,7 @@
 SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
 IF EXIST BUILD.OK DEL BUILD.OK
 IF EXIST TANDI.EXE DEL TANDI.EXE
-CL /nologo /c /G0 /Gw /AS /W3 /O /DWIN16 TANDI.C DB.C ENGINE.C OBSERVE.C TDSOUND.C > BUILD.LOG
+CL /nologo /c /G0 /Gw /AS /W3 /O /DWIN16 TANDI.C DB.C ENGINE.C OBSERVE.C DEMO.C TDSOUND.C > BUILD.LOG
 IF ERRORLEVEL 1 GOTO BAD
 LINK4 /MAP /NOE /NOD @TANDI.RSP >> BUILD.LOG
 IF ERRORLEVEL 1 GOTO BAD
--- a/SOURCE/src/DEMO.C
+++ b/SOURCE/src/DEMO.C
@@ -0,0 +1,85 @@
+/* Deterministic, paced demonstration of the unchanged engine. No UI/input/I/O
+   writes, settings, random numbers, learning or artificial engine delays. */
+#include "DEMO.H"
+#include <string.h>
+static const char *names[DEMO_ROSTER]={
+    "Mario","Lara Croft","Bugs Bunny","Mickey Mouse",
+    "SpongeBob SquarePants","Popeye","Snoopy","Charlie Brown"
+};
+int demo_due(U32 now,U32 due){return (U32)(now-due)<0x80000000UL;}
+static int game(TDDEMO *s,ENGINE *e,TDB *d,TDHISTORY *h,U32 now){
+    int q;s->target=s->roster[(s->sequence*3)%DEMO_ROSTER];
+    s->sequence=(s->sequence+1)%DEMO_ROSTER;
+    if(!db_row(d,s->target,s->truth))return 0;
+    for(q=0;q<(int)d->nq;q++)if(db_value(s->truth,q)==2)return 0;
+    eng_reset(e,d);obs_reset(h);s->phase=DEMO_TITLE;
+    s->steps=s->rejections=0;s->due=now+1500UL;return 1;
+}
+int demo_init(TDDEMO *s,ENGINE *e,TDB *d,TDHISTORY *h,U32 now){
+    int n,c,found;char name[40];memset(s,0,sizeof(*s));
+    /* Fail closed if an expected authored character is absent/unknown.
+       The DAT supplies every answer; no hand-coded answer script exists. */
+    for(n=0;n<DEMO_ROSTER;n++){
+        found=-1;
+        for(c=0;c<(int)d->nc;c++){
+            if(!db_name(d,c,name))return 0;
+            if(!strcmp(name,names[n])){found=c;break;}
+        }
+        if(found<0||!db_row(d,found,s->truth))return 0;
+        for(c=0;c<(int)d->nq;c++)if(db_value(s->truth,c)==2)return 0;
+        s->roster[n]=(U16)found;
+    }
+    s->enabled=game(s,e,d,h,now);return s->enabled;
+}
+static int prompt(TDDEMO *s,ENGINE *e,TDB *d,U32 now){
+    if(eng_confident(e,d)||eng_choose(e,d)<0){
+        if(e->best<0||d->error)return -1;
+        s->phase=DEMO_GUESS;s->due=now+2000UL;
+        return DEMO_CHANGED|DEMO_REVEAL;
+    }
+    s->phase=DEMO_QUESTION;s->due=now+1800UL;
+    return DEMO_CHANGED;
+}
+int demo_step(TDDEMO *s,ENGINE *e,TDB *d,TDHISTORY *h,U32 now){
+    int result;
+    if(!s->enabled||!demo_due(now,s->due))return 0;
+    s->side=(s->side+1)%6;
+    if(s->phase==DEMO_TITLE)return prompt(s,e,d,now);
+    if(s->phase==DEMO_QUESTION){
+        s->answer=db_value(s->truth,e->current);s->phase=DEMO_ANSWER;
+        s->due=now+700UL;return DEMO_CHANGED;
+    }
+    if(s->phase==DEMO_ANSWER){
+        if(!obs_answer(h,e,d,s->answer))goto failed;
+        if(++s->steps>(int)d->nq+(int)d->nc)goto failed;
+        result=prompt(s,e,d,now);if(result<0)goto failed;
+        if(e->turn%3==0&&s->phase==DEMO_QUESTION){
+            s->resume=DEMO_QUESTION;s->phase=DEMO_DARK;
+            s->due=now+1500UL;return DEMO_CHANGED|DEMO_STOPCUE;
+        }
+        return result;
+    }
+    if(s->phase==DEMO_GUESS){
+        if(e->best==s->target){
+            s->phase=DEMO_SUCCESS;s->due=now+1800UL;s->games++;
+            return DEMO_CHANGED|DEMO_VICTORY;
+        }
+        if(++s->rejections>=(int)d->nc)goto failed;
+        eng_reject(e,d);result=prompt(s,e,d,now);
+        if(result<0)goto failed;
+        return result;
+    }
+    if(s->phase==DEMO_SUCCESS){
+        s->resume=DEMO_TITLE;s->phase=DEMO_DARK;s->due=now+2200UL;
+        return DEMO_CHANGED|DEMO_STOPCUE;
+    }
+    if(s->phase==DEMO_DARK){
+        if(s->resume==DEMO_TITLE){
+            if(!game(s,e,d,h,now))goto failed;
+            return DEMO_CHANGED;
+        }
+        s->phase=s->resume;s->due=now+1800UL;return DEMO_CHANGED;
+    }
+failed:
+    s->enabled=0;return -1;
+}
--- a/SOURCE/src/DEMO.H
+++ b/SOURCE/src/DEMO.H
@@ -0,0 +1,25 @@
+#ifndef DEMO_H
+#define DEMO_H
+#include "OBSERVE.H"
+#define DEMO_ROSTER 8
+#define DEMO_TITLE 0
+#define DEMO_QUESTION 1
+#define DEMO_ANSWER 2
+#define DEMO_GUESS 3
+#define DEMO_SUCCESS 4
+#define DEMO_DARK 5
+#define DEMO_REVEAL 1
+#define DEMO_VICTORY 2
+#define DEMO_CHANGED 4
+#define DEMO_STOPCUE 8
+#define DEMO_IDLE_MS 60000UL
+typedef struct {
+    U16 roster[DEMO_ROSTER];
+    U8 truth[TD_ROW];
+    int enabled,phase,resume,target,sequence,answer,side,steps,rejections;
+    U32 due,games;
+} TDDEMO;
+int demo_init(TDDEMO *,ENGINE *,TDB *,TDHISTORY *,U32);
+int demo_step(TDDEMO *,ENGINE *,TDB *,TDHISTORY *,U32);
+int demo_due(U32,U32);
+#endif
--- a/SOURCE/src/DEMOUI.H
+++ b/SOURCE/src/DEMOUI.H
@@ -0,0 +1,317 @@
+/* Own-window input only. No global hook, input synthesis, settings or learning. */
+static void demoDraw(HDC dc){
+    RECT r;int left,x,y;char nm[40],q[80];COLORREF gold;
+    if(demoDrain||demonstration.phase==DEMO_DARK)return;
+    gold=colors<16?RGB(255,255,255):RGB(255,255,0);
+    x=demonstration.side%2?screenw-108*sx:0;
+    y=(demonstration.side/2)*7;
+    SetViewportOrg(dc,x,y);mascot(dc);SetViewportOrg(dc,0,0);
+    left=x?6*sx:104*sx;
+    r.left=left;r.right=left+210*sx;r.top=46+y;r.bottom=r.top+47;
+    SetTextColor(dc,RGB(255,255,255));SetBkColor(dc,RGB(0,0,0));
+    db_name(&db,demonstration.target,nm);
+    if(demonstration.phase==DEMO_TITLE){
+        wrapped(dc,"WATCH THE ORACLE GUESS",&r);r.top+=45;r.bottom+=45;wrapped(dc,nm,&r);
+    }else if(demonstration.phase==DEMO_QUESTION||demonstration.phase==DEMO_ANSWER){
+        db_question(&db,engine.current,q);wrapped(dc,q,&r);
+        r.top+=50;r.bottom+=50;
+        wrapped(dc,demonstration.phase==DEMO_ANSWER?factwords[demonstration.answer]:"CONSULTING...",&r);
+    }else if(demonstration.phase==DEMO_GUESS){
+        wrapped(dc,"I SUSPECT...",&r);r.top+=30;r.bottom+=30;
+        db_name(&db,engine.best,nm);wrapped(dc,nm,&r);
+    }else if(demonstration.phase==DEMO_SUCCESS){
+        wrapped(dc,"THE ORACLE HAS FOUND",&r);r.top+=30;r.bottom+=30;wrapped(dc,nm,&r);
+    }
+    sprite(dc,demonstration.side%2?8*sx:screenw-134*sx,4+y,126,16,0,360);
+    SetTextColor(dc,gold);
+    text(dc,left,170-y,"DEMO - ANY INPUT STOPS");
+}
+static int demoKeysHeld(void){
+    int i;for(i=1;i<256;i++)if(demoDown[i]||(GetAsyncKeyState(i)&0x8000))return 1;
+    return demoMouse!=0;
+}
+static void demoBlank(void){
+    HDC dc;TdSoundStop(window);dc=GetDC(window);
+    if(dc){box(dc,0,0,screenw,screenh,RGB(0,0,0));ReleaseDC(window,dc);}
+}
+static void demoCleanup(int returnFocus){
+    HWND previous=demoPreviousActive,focusBefore=demoPreviousFocus;
+    HCURSOR current;int owned;
+    if(demoReturning)return;demoReturning=1;
+    owned=GetActiveWindow()==window&&GetCapture()==window;
+    demonstration.enabled=demoDrain=0;TdSoundStop(window);animframe=-1;
+    if(owned){
+        /* Preserve a foreign cursor replacement even if ownership changed. */
+        current=SetCursor(NULL);SetCursor(current);
+        if(!current)SetCursor(demoPreviousCursor);
+    }
+    if(GetCapture()==window)ReleaseCapture();demoOwned=0;
+    TdSoundEnable(soundpref);
+    if(demoMode){
+        if(returnFocus&&owned&&previous&&IsWindow(previous)){
+            SetActiveWindow(previous);
+            if(focusBefore&&IsWindow(focusBefore))SetFocus(focusBefore);
+        }
+        DestroyWindow(window);
+    }else{
+        eng_reset(&engine,&db);obs_reset(&history);state=0;help=debug=explaining=0;
+        focus=busy=pending=capoffered=0;inputready=GetTickCount()+220;
+        if(returnFocus&&owned)SetFocus(window);
+        refresh();
+    }
+    demoReturning=0;
+}
+static int demoStart(void){
+    int i;
+    if(demonstration.enabled||demoDrain||busy||state!=0||history.count||
+       help||debug||explaining||!timerok||db.error||GetCapture()||
+       GetSysModalWindow()||GetActiveWindow()!=window||GetFocus()!=window)return 0;
+    if(!demoMode){demoPreviousActive=window;demoPreviousFocus=window;}
+    GetKeyboardState(demoInitial);
+    for(i=0;i<256;i++){
+        demoInitial[i]&=0x80;demoDown[i]=(BYTE)(demoInitial[i]?1:0);
+    }
+    demoMouse=demoMouseGesture=0;
+    if(demoInitial[VK_LBUTTON])demoMouse|=MK_LBUTTON;
+    if(demoInitial[VK_RBUTTON])demoMouse|=MK_RBUTTON;
+    if(demoInitial[VK_MBUTTON])demoMouse|=MK_MBUTTON;
+    GetCursorPos(&demoOrigin);ScreenToClient(window,&demoOrigin);
+    demoStarted=demoLastInput=GetTickCount();
+    if(!demo_init(&demonstration,&engine,&db,&history,(U32)demoStarted))return 0;
+    SetCapture(window);demoOwned=GetCapture()==window;
+    if(!demoOwned||GetActiveWindow()!=window||GetFocus()!=window){demoCleanup(0);return 0;}
+    TdSoundStop(window);TdSoundEnable(demoCues&&soundpref);
+    demoPreviousCursor=SetCursor(NULL);demoArmed=0;nb=0;state=0;
+    lookx=looky=0;animframe=-1;animticks=idleticks=0;
+    InvalidateRect(window,0,FALSE);UpdateWindow(window);return 1;
+}
+static void demoWake(void){
+    if(!demoDrain){demoDrain=1;demoWakeCount++;demoBlank();}
+    demoLastInput=GetTickCount();
+}
+static int demoInput(UINT m,WORD wp,LONG lp){
+    int was,dx,dy;
+    if(!demonstration.enabled&&!demoDrain){
+        if((m>=WM_KEYFIRST&&m<=WM_KEYLAST)||
+           (m>=WM_MOUSEFIRST&&m<=WM_MOUSELAST&&m!=WM_MOUSEMOVE))demoArmed=0;
+        else if(m==WM_MOUSEMOVE){
+            dx=(int)LOWORD(lp)-demoOrigin.x;dy=(int)HIWORD(lp)-demoOrigin.y;
+            if(dx||dy)demoArmed=0;
+        }
+        return 0;
+    }
+    if(m>=WM_KEYFIRST&&m<=WM_KEYLAST){
+        if(m==WM_KEYDOWN||m==WM_SYSKEYDOWN){if(wp<256)demoDown[wp]=1;demoWake();}
+        else if(m==WM_KEYUP||m==WM_SYSKEYUP){
+            was=wp<256?demoInitial[wp]:0;
+            if(wp<256)demoDown[wp]=demoInitial[wp]=0;
+            if(!was||GetTickCount()-demoStarted>=250UL||demoDrain)demoWake();
+        }else demoWake();
+        return 1;
+    }
+    if(m>=WM_MOUSEFIRST&&m<=WM_MOUSELAST){
+        if(m!=WM_MOUSEMOVE)demoMouseGesture=1;
+        demoMouse=wp&(MK_LBUTTON|MK_RBUTTON|MK_MBUTTON);
+        if(m==WM_LBUTTONDOWN||m==WM_LBUTTONDBLCLK)demoMouse|=MK_LBUTTON;
+        if(m==WM_RBUTTONDOWN||m==WM_RBUTTONDBLCLK)demoMouse|=MK_RBUTTON;
+        if(m==WM_MBUTTONDOWN||m==WM_MBUTTONDBLCLK)demoMouse|=MK_MBUTTON;
+        if(m==WM_LBUTTONUP)demoMouse&=~MK_LBUTTON;
+        if(m==WM_RBUTTONUP)demoMouse&=~MK_RBUTTON;
+        if(m==WM_MBUTTONUP)demoMouse&=~MK_MBUTTON;
+        dx=(int)LOWORD(lp)-demoOrigin.x;dy=(int)HIWORD(lp)-demoOrigin.y;
+        if(m!=WM_MOUSEMOVE||dx||dy)demoWake();
+        return 1;
+    }
+    return 0;
+}
+static void demoDrainTick(void){
+    MSG msg;DWORD quiet=demoMouseGesture?(DWORD)GetDoubleClickTime():220UL;
+    if(quiet<220UL)quiet=220UL;
+    if(GetActiveWindow()!=window||GetFocus()!=window||GetCapture()!=window){demoCleanup(0);return;}
+    while(PeekMessage(&msg,window,WM_KEYFIRST,WM_KEYLAST,PM_REMOVE))
+        demoInput(msg.message,msg.wParam,msg.lParam);
+    while(PeekMessage(&msg,window,WM_MOUSEFIRST,WM_MOUSELAST,PM_REMOVE))
+        demoInput(msg.message,msg.wParam,msg.lParam);
+    if(demoKeysHeld()){demoLastInput=GetTickCount();return;}
+    if(GetTickCount()-demoLastInput<quiet)return;
+    demoCleanup(1);
+}
+static void demoPulse(void){
+    int event;DWORD now=GetTickCount();
+    if(GetActiveWindow()!=window||GetCapture()!=window||GetFocus()!=window){demoCleanup(0);return;}
+    TdSoundTick(window,now);
+    event=demo_step(&demonstration,&engine,&db,&history,now);
+    if(event<0){demoCleanup(1);return;}
+    if(event){
+        state=demonstration.phase==DEMO_GUESS?2:(demonstration.phase==DEMO_SUCCESS?3:0);
+        animticks=0;animframe=state==2?1:(state==3?3:-1);
+        if(event&DEMO_STOPCUE)TdSoundStop(window);
+        if(event&DEMO_REVEAL)TdSoundBegin(window,TD_SND_REVEAL,GetTickCount());
+        if(event&DEMO_VICTORY)TdSoundBegin(window,TD_SND_VICTORY,GetTickCount());
+        InvalidateRect(window,0,FALSE);UpdateWindow(window);
+    }else{
+        if(state==2||state==3){
+            if(animticks<10){animticks++;
+                if(!(animticks%2))animset(state==2?(animticks%4?1:2):(animticks%4?3:4));
+            }
+        }else if(demonstration.phase!=DEMO_DARK){
+            idleticks++;lookx=(idleticks/4)%3-1;looky=(idleticks/12)%3-1;
+            if(idleticks==36)animset(0);
+            if(idleticks>=38){animset(-1);idleticks=0;}
+            InvalidateRect(window,0,FALSE);
+        }
+    }
+}
+/* /J is a bounded native fixture; all messages target our own window.
+   It advances demo deadlines for coverage, not production timing. */
+LONG FAR PASCAL DemoPeerProc(HWND w,UINT m,WORD wp,LONG lp){
+    if((m>=WM_KEYFIRST&&m<=WM_KEYLAST)||(m>=WM_MOUSEFIRST&&m<=WM_MOUSELAST)){
+        if(m!=WM_MOUSEMOVE)demoInputLeaks++;return 0;
+    }
+    return DefWindowProc(w,m,wp,lp);
+}
+static void demoQACheck(char *key,int ok){metric(key,ok);if(!ok)demoQAErrors++;}
+static void demoQANew(void){
+    BringWindowToTop(window);SetActiveWindow(window);SetFocus(window);state=0;eng_reset(&engine,&db);obs_reset(&history);
+    demoQACheck("DEMO_START",demoStart());demoTestTicks=0;
+}
+static void demoQATick(void){
+    int i,old;char path[30],n[12];TDSNDSTAT stats;
+    if(++demoTestTicks>1400){metric("DEMO_TIMEOUT",1);SendMessage(window,WM_CLOSE,0,0);return;}
+    if(!demoTestStage){
+        WNDCLASS c;
+        c.style=0;c.lpfnWndProc=DemoPeerProc;c.cbClsExtra=c.cbWndExtra=0;
+        c.hInstance=instance;c.hIcon=0;c.hCursor=LoadCursor(NULL,IDC_CROSS);
+        c.hbrBackground=GetStockObject(WHITE_BRUSH);c.lpszMenuName=0;c.lpszClassName="TandiDemoPeer";
+        RegisterClass(&c);demoPeer=CreateWindow(c.lpszClassName,"DEMO QA",WS_POPUP,
+                            0,0,screenw,screenh,0,0,instance,0);
+        ShowWindow(demoPeer,SW_SHOWNOACTIVATE);
+        BringWindowToTop(window);
+        SetActiveWindow(window);SetFocus(window);
+        demoQASoundPref=soundpref;demoQAInitialSetting=GetProfileInt("TANDINATOR","Sound",-1);
+        demoQACheck("DEMO_TEST_PROFILE_SUPPRESSED",!testmode);
+        /* Opt-in idle arm never starts on an active game. */
+        state=1;history.count=1;demoWelcome=GetTickCount()-DEMO_IDLE_MS;
+        animtick();demoQACheck("DEMO_NO_MIDGAME_ACTIVATION",!demonstration.enabled);
+        state=0;history.count=0;demoArmed=0;animtick();
+        demoQACheck("DEMO_DISARMED_STAYS_OFF",!demonstration.enabled);
+        demoArmed=1;animtick();demoQACheck("DEMO_IDLE_ACTIVATES",demonstration.enabled);
+        demoQACheck("DEMO_CUES_OPTIN",TdSoundEnabled()==(demoCues&&soundpref));
+        demoTestStage=1;demoTestTicks=0;return;
+    }
+    if(demoTestStage==1){
+        if(!demonstration.enabled){demoQACheck("DEMO_CYCLE_ALIVE",0);demoTestStage=99;return;}
+        if(++demoQAPhases%3==0){
+            demonstration.due=GetTickCount();demoPulse();
+            if(demonstration.phase==DEMO_SUCCESS){
+                for(i=0;i<8;i++)if(demonstration.target==(int)demonstration.roster[i])demoQASeen[i]++;
+            }
+            if(demoQAFrames<36){
+                lstrcpy(path,"C:\\D");number(n,demoQAFrames++);lstrcat(path,n);lstrcat(path,".BIN");capture(path);
+                metric("DEMO_FRAME_PHASE",demonstration.phase);metric("DEMO_FRAME_SIDE",demonstration.side);
+            }
+        }else if(demonstration.phase==DEMO_QUESTION&&demoQAEyes<6){
+            lookx=demoQAEyes%3-1;looky=demoQAEyes/3;animframe=-1;
+            InvalidateRect(window,0,FALSE);UpdateWindow(window);
+            lstrcpy(path,"C:\\DEYE");number(n,demoQAEyes++);lstrcat(path,n);lstrcat(path,".BIN");capture(path);
+            metric("DEMO_EYE_SIDE",demonstration.side);
+        }
+        if(demonstration.games<8)return;
+        old=1;for(i=0;i<8;i++)if(demoQASeen[i]!=1)old=0;
+        demoQACheck("DEMO_EIGHT_TARGETS",old);
+        TdSoundGetStats(&stats);metric("DEMO_SOUND_WRITES",stats.portWrites);
+        demoQACheck("DEMO_SOUND_OFF_QUIET",(demoCues&&soundpref)||!stats.portWrites);
+        demoQACheck("DEMO_DEFAULT_QUIET",demoCues||!stats.portWrites);
+        demoCleanup(1);demoTestStage=2;demoQACase=0;return;
+    }
+    if(demoTestStage==2){
+        demoQANew();
+        if(demoQACase==0){
+            SendMessage(window,WM_MOUSEMOVE,0,MAKELONG(demoOrigin.x,demoOrigin.y));
+            demoQACheck("DEMO_IDENTICAL_MOVE_IGNORED",demonstration.enabled&&!demoDrain);
+            demoInitial[VK_F1]=demoDown[VK_F1]=1;demoStarted=GetTickCount();
+            SendMessage(window,WM_KEYUP,VK_F1,0);
+            demoQACheck("DEMO_INITIAL_RELEASE_IGNORED",!demoDrain);
+            SendMessage(window,WM_KEYDOWN,VK_F3,0);
+            SendMessage(window,WM_KEYDOWN,VK_F3,0x40000000L);
+            SendMessage(window,WM_CHAR,'x',0);
+            PostMessage(window,WM_KEYDOWN,VK_RETURN,0);
+            PostMessage(window,WM_CHAR,13,0);
+            PostMessage(window,WM_KEYUP,VK_RETURN,0);
+            demoQACheck("DEMO_FIRST_KEY_BLANKS",demoDrain);
+            capture("C:\\DWAKE.BIN");
+            demoQACheck("DEMO_F3_NO_WRITE",soundpref==demoQASoundPref&&
+                (int)GetProfileInt("TANDINATOR","Sound",-1)==demoQAInitialSetting);
+            TdSoundGetStats(&stats);demoQACheck("DEMO_WAKE_STOPS_SOUND",!stats.playing);
+            demoQAHeldTicks=0;demoTestStage=3;return;
+        }
+        if(demoQACase==1){
+            SendMessage(window,WM_LBUTTONDOWN,MK_LBUTTON,MAKELONG(210*sx,130));
+            SendMessage(window,WM_LBUTTONDBLCLK,MK_LBUTTON,MAKELONG(210*sx,130));
+            demoQAHeldTicks=0;demoTestStage=3;return;
+        }
+        if(demoQACase==2){
+            SendMessage(window,WM_MOUSEMOVE,0,MAKELONG(demoOrigin.x+1,demoOrigin.y));
+            demoQACheck("DEMO_REAL_MOVE_WAKES",demoDrain);demoTestStage=4;return;
+        }
+        if(demoQACase==3){
+            SetCapture(demoPeer);demoPulse();
+            demoQACheck("DEMO_FOREIGN_CAPTURE_PRESERVED",!demonstration.enabled&&GetCapture()==demoPeer);
+            ReleaseCapture();demoTestStage=5;return;
+        }
+        if(demoQACase==4){
+            SetCursor(LoadCursor(NULL,IDC_CROSS));SetFocus(demoPeer);
+            demoQACheck("DEMO_FOCUS_LOSS_STOPS",!demonstration.enabled&&GetFocus()==demoPeer);
+            {HCURSOR cursor=SetCursor(NULL);SetCursor(cursor);
+                demoQACheck("DEMO_FOREIGN_CURSOR_PRESERVED",cursor==LoadCursor(NULL,IDC_CROSS));}
+            demoTestStage=5;return;
+        }
+        if(demoQACase==5){
+            SendMessage(window,WM_CANCELMODE,0,0);
+            demoQACheck("DEMO_CANCEL_STOPS",!demonstration.enabled&&GetCapture()!=window);
+            demoTestStage=5;return;
+        }
+        if(demoQACase==6){
+            SendMessage(window,WM_SYSKEYDOWN,VK_MENU,0);
+            SendMessage(window,WM_SYSCHAR,'x',0);
+            SendMessage(window,WM_SYSKEYUP,VK_MENU,0);
+            demoQACheck("DEMO_SYSTEM_KEY_CONSUMED",demoDrain);demoTestStage=4;return;
+        }
+        if(demoQACase==7){
+            SendMessage(window,WM_ACTIVATEAPP,0,0);
+            demoQACheck("DEMO_TASK_SWITCH_STOPS",!demonstration.enabled&&GetCapture()!=window);
+            demoQACheck("DEMO_INACTIVE_ANIMATION_STOPS",!active);
+            SendMessage(window,WM_ACTIVATEAPP,1,0);demoTestStage=5;return;
+        }
+        /* Dedicated /S restoration shares this exact close path. */
+        demoMode=1;demoPreviousActive=demoPreviousFocus=demoPeer;
+        SendMessage(window,WM_KEYDOWN,VK_RETURN,0);
+        SendMessage(window,WM_KEYUP,VK_RETURN,0);
+        demoQACheck("DEMO_SETTING_UNCHANGED",soundpref==demoQASoundPref&&
+            (int)GetProfileInt("TANDINATOR","Sound",-1)==demoQAInitialSetting);
+        demoQACheck("DEMO_NO_INPUT_LEAKS",!demoInputLeaks);
+        demoQACheck("DEMO_NATIVE_ALL_CHECKS",!demoQAErrors);
+        metric("ERRORS",demoQAErrors);metric("COMPLETE",1);demoTestStage=6;return;
+    }
+    if(demoTestStage==3){
+        if(++demoQAHeldTicks<5)return;
+        demoQACheck("DEMO_HELD_DRAIN",demoDrain&&GetCapture()==window);
+        if(!demoQACase)SendMessage(window,WM_KEYUP,VK_F3,0);
+        else SendMessage(window,WM_LBUTTONUP,0,0);
+        demoTestStage=4;return;
+    }
+    if(demoTestStage==4){
+        if(demoQACase==1&&demoQAHeldTicks<10){
+            if(++demoQAHeldTicks<9)return;
+            demoQACheck("DEMO_DELAYED_DOUBLE_CLICK_DRAIN",demoDrain&&GetCapture()==window);
+            SendMessage(window,WM_LBUTTONDBLCLK,MK_LBUTTON,0);
+            SendMessage(window,WM_LBUTTONUP,0,0);demoQAHeldTicks=10;
+        }
+        if(demoDrain)return;
+        demoQACheck("DEMO_WAKE_NO_GAME_ACTION",state==0&&engine.turn==0&&history.count==0&&!help&&!debug&&!explaining);
+        demoQACheck("DEMO_DRAIN_RELEASED",GetCapture()!=window);
+        demoQACheck("DEMO_IDLE_NOT_REARMED",!demoArmed);demoTestStage=5;
+    }
+    if(demoTestStage==5){demoQACase++;demoTestStage=2;return;}
+    if(demoTestStage==99){metric("ERRORS",demoQAErrors+1);metric("COMPLETE",1);SendMessage(window,WM_CLOSE,0,0);}
+}
