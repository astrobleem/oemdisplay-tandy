--- a/SOURCE/tests/ART10.PY
+++ b/SOURCE/tests/ART10.PY
@@ -0,0 +1,67 @@
+from pathlib import Path
+import importlib.machinery,json,re,shutil,hashlib
+from PIL import Image,ImageDraw
+p=Path(__file__).resolve().parents[1]
+m=importlib.machinery.SourceFileLoader('demoart',str(p/'tests/ARTTEST.PY')).load_module()
+atlas=Image.open(p/'art/ATLAS.PNG').convert('RGB')
+source=(p/'src/TANDI.C').read_text()
+palettes={16:m.PALETTE,2:[(0,0,0),(255,255,255)],4:[(0,0,0),(255,85,85),(85,255,85),(255,255,255)]}
+sha=lambda f:hashlib.sha256(f.read_bytes()).hexdigest()
+reports=[];preview=[]
+for mode in m.MODES:
+ old=p/'evidence'/('demo-'+mode);r=json.loads((old/'RESULT.JSN').read_text())
+ assert r['exe_sha256']==sha(p/'src/TANDI.EXE') and 'DEMO_NATIVE_ALL_CHECKS=1\n' in r['log']
+ dest=p/'evidence'/('demo-'+mode);dest.mkdir(exist_ok=True)
+ frames={}
+ for f in old.glob('D*.BIN'):
+  frames[f.stem]=m.decode_vram(f.read_bytes(),mode)
+ phases=list(map(int,re.findall(r'^DEMO_FRAME_PHASE=(\d+)$',r['log'],re.M)))
+ sides=list(map(int,re.findall(r'^DEMO_FRAME_SIDE=(\d+)$',r['log'],re.M)))
+ assert len(phases)==len(sides)==36
+ width,colors,_,_=m.MODES[mode];sx=width//320
+ if colors==16:mapping=list(range(16))
+ else:
+  logical=m.c_array(source,'monomap' if colors==2 else 'lowmap',16)
+  hw={0:0,15:1} if colors==2 else {0:0,12:1,10:2,15:3}
+  mapping=[hw[v] for v in logical]
+ checks=0;black=0;poses=set();positions=set()
+ for n,(phase,side) in enumerate(zip(phases,sides)):
+  frame=frames['D'+str(n)];x0=width-108*sx if side%2 else 0;y0=(side//2)*7
+  if phase==5:assert not any(frame);black+=1;continue
+  pose=1 if phase==3 else 2 if phase==4 else 0;poses.add(pose);positions.add(side)
+  for y in range(120):
+   for x in range(96):
+    if 35<=x<59 and 42<=y<60:continue
+    expected=mapping[m.PALETTE.index(atlas.getpixel((x,y+120*pose)))]
+    for dup in range(sx):
+     actual=frame[(43+y0+y)*width+x0+(6+x)*sx+dup]
+     assert actual==expected,(mode,n,'cabinet',x,y,actual,expected)
+     checks+=1
+  if phase in [3,4]:
+   face=1 if phase==3 else 3
+   for y in range(18):
+    for x in range(24):
+     expected=mapping[m.PALETTE.index(atlas.getpixel((x+(face%4)*32,416+y+(face//4)*20)))]
+     for dup in range(sx):assert frame[(85+y0+y)*width+x0+(41+x)*sx+dup]==expected,(mode,n,'face',x,y)
+  lx=8*sx if side%2 else width-134*sx
+  for y in range(16):
+   for x in range(126):
+    expected=mapping[m.PALETTE.index(atlas.getpixel((x,y+360)))]
+    for dup in range(sx):assert frame[(4+y0+y)*width+lx+x*sx+dup]==expected,(mode,n,'logo',x,y)
+ assert black and poses=={0,1,2} and positions==set(range(6))
+ assert not any(frames['DWAKE'])
+ eyeSides=list(map(int,re.findall(r'^DEMO_EYE_SIDE=(\d+)$',r['log'],re.M)))
+ eyeChecks=[]
+ for a,b in [(0,1),(2,3),(4,5)]:
+  if eyeSides[a]!=eyeSides[b]:continue
+  side=eyeSides[a];x0=width-108*sx if side%2 else 0;y0=(side//2)*7
+  diff=[i for i,(u,v) in enumerate(zip(frames['DEYE'+str(a)],frames['DEYE'+str(b)])) if u!=v]
+  assert diff and all((x0+45*sx<=i%width<x0+52*sx or x0+53*sx<=i%width<x0+60*sx) and 85+y0<=i//width<94+y0 for i in diff),(mode,'eyes',a,b)
+  eyeChecks.append(len(diff))
+ assert eyeChecks
+ report={'mode':mode,'exe_sha256':r['exe_sha256'],'cabinet_pixels_checked':checks,
+  'cabinet_exact_outside_animated_face':True,'logo_exact':True,'cabinet_poses':sorted(poses),
+  'six_positions':True,'all_black_interludes':black,'wake_all_black':True,'eye_pair_changes':eyeChecks,
+  'native_checks_passed':True,'seconds':r['seconds'],'sound_cues_optin':r['command']=='/J /C'}
+ reports.append(report)
+print(json.dumps(reports,indent=2))
--- a/SOURCE/tests/BUILD10.BAT
+++ b/SOURCE/tests/BUILD10.BAT
@@ -0,0 +1,13 @@
+@ECHO OFF
+SET PATH=C:\BIN;Z:\
+SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
+CL /nologo /c /G0 /Gw /AS /W3 /O LAUNCH10.C > BUILD.LOG
+IF ERRORLEVEL 1 GOTO BAD
+LINK4 /MAP /NOE /NOD @LAUNCH10.RSP >> BUILD.LOG
+IF ERRORLEVEL 1 GOTO BAD
+ECHO COMPILE_LINK_OK > BUILD.OK
+GOTO END
+:BAD
+ECHO FAILED >> BUILD.LOG
+:END
+EXIT
--- a/SOURCE/tests/DEMO10.C
+++ b/SOURCE/tests/DEMO10.C
@@ -0,0 +1,48 @@
+/* Actual engine/data, deterministic pacing, no UI or synthetic global input. */
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "../src/DEMO.H"
+static TDB db;
+static ENGINE engine;
+static TDHISTORY history;
+static TDDEMO demo,copy;
+static int seen[TD_MAXC];
+int main(int argc,char **argv){
+    U32 now=0xfffffe00UL;int event,calls=0,i,games=0,oldphase;
+    if(argc!=2||!db_open(&db,argv[1]))return 2;
+    assert(demo_due(1UL,0xfffffffeUL));
+    assert(!demo_due(0xfffffffeUL,1UL));
+    assert(demo_init(&demo,&engine,&db,&history,now));
+    for(i=0;i<DEMO_ROSTER;i++)assert(!seen[demo.roster[i]]++);
+    memset(seen,0,sizeof(seen));
+    while(demo.games<64){
+        assert(++calls<50000);copy=demo;
+        assert(!demo_step(&demo,&engine,&db,&history,demo.due-1UL));
+        assert(!memcmp(&copy,&demo,sizeof(demo)));
+        oldphase=demo.phase;now=demo.due;
+        event=demo_step(&demo,&engine,&db,&history,now);
+        assert(event>0&&demo.enabled);
+        assert(demo.phase!=oldphase);
+        assert(demo.due!=now&&!demo_due(now,demo.due));
+        assert(engine.turn==history.count);
+        assert(!demo_step(&demo,&engine,&db,&history,now));
+        if(event&DEMO_VICTORY){
+            assert(demo.phase==DEMO_SUCCESS&&engine.best==demo.target);
+            seen[demo.target]++;games++;
+            printf("game=%d target=%d answers=%d rejects=%d\n",games,demo.target,engine.turn,demo.rejections);
+        }
+    }
+    for(i=0;i<DEMO_ROSTER;i++)assert(seen[demo.roster[i]]==8);
+    /* Large timer lateness advances one phase only, no catch-up burst. */
+    copy=demo;now=demo.due+100000UL;
+    assert(demo_step(&demo,&engine,&db,&history,now)>0);
+    assert(demo.phase!=copy.phase&&!demo_step(&demo,&engine,&db,&history,now));
+    demo.enabled=0;copy=demo;
+    assert(!demo_step(&demo,&engine,&db,&history,now+100000UL));
+    assert(!memcmp(&copy,&demo,sizeof(demo)));
+    /* Fail closed before altering the active engine when a name is missing. */
+    db.nc=0;copy=demo;assert(!demo_init(&demo,&engine,&db,&history,now));
+    printf("PASS games=%d calls=%d wrap=1 no_catchup=1 disabled=1 missing=1\n",games,calls);
+    db_close();return 0;
+}
--- a/SOURCE/tests/DEMO10.PY
+++ b/SOURCE/tests/DEMO10.PY
@@ -0,0 +1,29 @@
+"""Bounded host qualification of the separate, unfinished demo module."""
+from pathlib import Path
+import hashlib,json,os,subprocess
+p=Path(__file__).resolve().parents[1]
+sha=lambda f:hashlib.sha256(f.read_bytes()).hexdigest()
+base=json.loads((p/'evidence/BASE10.JSN').read_text())
+pins=['src/ENGINE.C','src/DB.C','src/OBSERVE.C','src/ART.H','src/TDSOUND.C',
+      'build/TANDY.DAT','build/AUDIT08.DAT','data/STARTER.JSON','data/AUDIT08.JSON']
+for name in pins:assert sha(p/name)==base['source_files'][name],name
+exe=p/'build/DEMO10.EXE'
+subprocess.run([os.environ.get('CC','gcc'),'-std=c89','-O2','-Wall','-Wextra',
+ '-Werror','-pedantic','-x','c',str(p/'tests/DEMO10.C'),str(p/'src/DEMO.C'),
+ str(p/'src/ENGINE.C'),str(p/'src/DB.C'),str(p/'src/OBSERVE.C'),'-o',str(exe)],check=True)
+reports={}
+for tag,dat in [('STANDARD','TANDY.DAT'),('AUDIT08','AUDIT08.DAT')]:
+ runs=[subprocess.check_output([str(exe),str(p/'build'/dat)]) for _ in range(2)]
+ assert runs[0]==runs[1]
+ assert runs[0].count(b'game=')==64 and b'PASS games=64 ' in runs[0]
+ (p/'evidence'/('DEMO10-'+tag+'.TXT')).write_bytes(runs[0].replace(b'\r\n',b'\n').replace(b'\n',b'\r\n'))
+ reports[tag]={'games':64,'authored_characters':8,'repeats_per_character':8,
+  'repeat_byte_exact':True,'dat_sha256':sha(p/'build'/dat),
+  'wraparound':True,'no_early_step':True,'no_late_catchup':True,
+  'disabled_no_step':True,'missing_name_fails_closed':True}
+report={'status':'host-only deterministic pacing module checks; see NATIVE10.JSN for separate app qualification',
+ 'source_packet_sha256':base['packet_sha256'],'unchanged_pins':pins,'datasets':reports,
+ 'no_native_demo_claim':True,'no_publication':True,'tshell_integration':
+ 'Verified upstream whitelist supports Matrix/Maze/Starfield. The separate optional TSHELL sources register Tandinator through configuration, launch, preview/close and Hold; see SHELL10.JSN for native evidence.'}
+(p/'evidence/DEMO10.JSN').write_bytes((json.dumps(report,indent=2)+'\n').replace('\n','\r\n').encode())
+print(json.dumps(report,indent=2))
--- a/SOURCE/tests/LAUNCH10.C
+++ b/SOURCE/tests/LAUNCH10.C
@@ -0,0 +1,72 @@
+/* First-party private-fixture launcher: Win3 boot shell accepts a file only.
+   Pass real WinMain arguments through WinExec. No global input generation. */
+#define WINVER 0x0300
+#include <windows.h>
+static HWND child,own;static int seen,ticks,mode,stage,leaks;
+static HFILE log=-1;
+static void note(char *s){if(log!=-1){_lwrite(log,s,lstrlen(s));_lwrite(log,"\r\n",2);}}
+LONG FAR PASCAL LaunchProc(HWND w,UINT m,WORD wp,LONG lp){
+    /* This caller owns its deliberately supplied cursor; its class default
+       must not overwrite that value while testing child cleanup. */
+    if(m==WM_SETCURSOR&&mode==4&&stage)return 1;
+    if(m==WM_TIMER){
+        child=FindWindow("TandyTandinatorSaver",NULL);
+        if(child)seen=1;
+        if(GetModuleHandle("TANDI"))seen=1;
+        if(mode&&child){
+            if(++ticks==20){
+                stage=1;
+                if(mode==1){SendMessage(child,WM_KEYDOWN,VK_RETURN,0);SendMessage(child,WM_CHAR,13,0);}
+                else if(mode==2)SendMessage(child,WM_LBUTTONDOWN,MK_LBUTTON,0);
+                else if(mode==3)SetCapture(w);
+                else if(mode==4){SetCursor(LoadCursor(NULL,IDC_CROSS));SetFocus(w);}
+                else if(mode==5)SendMessage(child,WM_CLOSE,0,0);
+                else SendMessage(child,WM_QUERYENDSESSION,0,0);
+                stage=1;
+            }
+            if(stage==1&&ticks==26){
+                if(mode<3){note(IsWindow(child)&&GetCapture()==child?"PRODUCTION HELD PASS":"PRODUCTION HELD FAIL");
+                    if(mode==1)SendMessage(child,WM_KEYUP,VK_RETURN,0);
+                    else SendMessage(child,WM_LBUTTONUP,0,0);}
+                stage=2;
+            }
+            if(mode==2&&stage==2&&ticks==30){
+                note(IsWindow(child)&&GetCapture()==child?"PRODUCTION DOUBLE DRAIN PASS":"PRODUCTION DOUBLE DRAIN FAIL");
+                SendMessage(child,WM_LBUTTONDBLCLK,MK_LBUTTON,0);SendMessage(child,WM_LBUTTONUP,0,0);stage=3;
+            }
+        }
+        if(seen&&!GetModuleHandle("TANDI")){
+            if(mode){
+                note(!leaks?"PRODUCTION INPUT LEAKS ZERO":"PRODUCTION INPUT LEAK FAIL");
+                if(mode<3)note(GetActiveWindow()==w&&GetFocus()==w?"PRODUCTION RESTORE PASS":"PRODUCTION RESTORE FAIL");
+                if(mode==3){note(GetCapture()==w?"PRODUCTION CAPTURE PASS":"PRODUCTION CAPTURE FAIL");ReleaseCapture();}
+                if(mode==4){HCURSOR cursor=SetCursor(NULL);SetCursor(cursor);note(cursor==LoadCursor(NULL,IDC_CROSS)?"PRODUCTION CURSOR PASS":"PRODUCTION CURSOR FAIL");}
+                note("PRODUCTION COMPLETE");
+            }
+            DestroyWindow(w);
+        }
+        return 0;
+    }
+    if((m>=WM_KEYFIRST&&m<=WM_KEYLAST)||(m>=WM_MOUSEFIRST&&m<=WM_MOUSELAST)){
+        if(mode&&stage&&m!=WM_MOUSEMOVE)leaks++;return 0;
+    }
+    if(m==WM_DESTROY){KillTimer(w,1);if(log!=-1)_lclose(log);PostQuitMessage(0);return 0;}
+    return DefWindowProc(w,m,wp,lp);
+}
+int PASCAL WinMain(HANDLE inst,HANDLE prev,LPSTR cmd,int show){
+    WNDCLASS c;MSG m;char args[80],command[100];int result;
+    (void)prev;(void)cmd;
+    c.style=0;c.lpfnWndProc=LaunchProc;c.cbClsExtra=c.cbWndExtra=0;
+    c.hInstance=inst;c.hIcon=0;c.hCursor=LoadCursor(NULL,IDC_ARROW);
+    c.hbrBackground=GetStockObject(WHITE_BRUSH);c.lpszMenuName=0;c.lpszClassName="TandiDemoLaunch";
+    if(!RegisterClass(&c))return 1;
+    own=CreateWindow(c.lpszClassName,"Demo launcher",WS_POPUP,0,0,
+                    GetSystemMetrics(SM_CXSCREEN),GetSystemMetrics(SM_CYSCREEN),0,0,inst,0);
+    ShowWindow(own,show);SetActiveWindow(own);SetFocus(own);UpdateWindow(own);
+    GetProfileString("DemoFixture","Command","/J",args,sizeof(args));
+    mode=GetProfileInt("DemoFixture","Production",0);log=_lcreat("C:\\LAUNCH.LOG",0);
+    lstrcpy(command,"TANDI.EXE ");lstrcat(command,args);
+    result=WinExec(command,SW_SHOWNORMAL);if(result<32){note("LAUNCH FAILED");DestroyWindow(own);return 1;}
+    SetTimer(own,1,100,NULL);
+    while(GetMessage(&m,0,0,0)){TranslateMessage(&m);DispatchMessage(&m);}return m.wParam;
+}
