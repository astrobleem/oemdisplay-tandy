--- a/SOURCE/tools/TSQA10.PY
+++ b/SOURCE/tools/TSQA10.PY
@@ -0,0 +1,93 @@
+"""Private Windows fixture runner: owned media stays outside deliverables."""
+from pathlib import Path
+import hashlib,json,shutil,subprocess,sys,time,os
+import importlib.machinery
+lease=importlib.machinery.SourceFileLoader("emulease",str(Path(__file__).with_name("EMULEASE.PY"))).load_module().lease
+P=Path(__file__).resolve().parents[1]
+root=Path(os.environ['TANDI_PRIVATE'])
+MODES={'320x200x16':'TR53216.DRV','640x200x2':'TR56402.DRV','640x200x4':'TR56404.DRV'}
+def ini(path,section,key,value):
+    out=[];active=False;found=False
+    for line in path.read_text().splitlines():
+        if line.strip().startswith('['):
+            if active and not found:out.append(key+'='+value);found=True
+            active=line.strip().lower()=='['+section.lower()+']'
+        if active and '=' in line and line.split('=',1)[0].strip().lower()==key.lower():
+            out.append(key+'='+value);found=True
+        else:out.append(line)
+    if not found:
+        if not active:out.append('['+section+']')
+        out.append(key+'='+value)
+    path.write_bytes(('\r\n'.join(out)+'\r\n').encode('ascii'))
+def run(mode,tag):
+    dest=root/'native-results'/(mode+'-'+tag)
+    dest.mkdir(parents=True,exist_ok=False)
+    guest=dest/'guest';guest.mkdir();shutil.copytree(Path(os.environ['TANDI_WINDOWS']),guest/'WINDOWS')
+    shutil.copyfile(Path(os.environ['TANDI_RESERVE']),guest/'RESERVE.COM')
+    shutil.copyfile(Path(os.environ['TANDI_TRIAL7'])/MODES[mode],guest/'WINDOWS/SYSTEM/TRIAL.DRV')
+    shutil.copyfile(P/'src/TANDI.EXE',guest/'WINDOWS/TANDI.EXE')
+    shutil.copyfile(P.parent/'TSHELL/TS10QA.EXE',guest/'WINDOWS/TS10QA.EXE')
+    data=bytearray((P/'build/TANDY.DAT').read_bytes())
+    (guest/'WINDOWS/TANDY.DAT').write_bytes(data)
+    for k,v in [('display.drv','TRIAL.DRV'),('shell','TS10QA.EXE'),('fonts.fon','CGASYS.FON'),('fixedfon.fon','CGAFIX.FON'),('oemfonts.fon','CGAOEM.FON')]:ini(guest/'WINDOWS/SYSTEM.INI','boot',k,v)
+    (guest/'WINDOWS/TSHELL.INI').write_bytes(b'[ScreenSaver]\r\nEnabled=0\r\nChoice=Matrix\r\nIdleSeconds=300\r\nTandinatorProgram=C:\\WINDOWS\\TANDI.EXE\r\n')
+    for k,v in [('Test','1'),('TestTarget','Mario'),('TestExit',str(list(MODES).index(mode)+1)),('Sound','0')]:ini(guest/'WINDOWS/WIN.INI','TANDINATOR',k,v)
+    for k in ['run','load']:ini(guest/'WINDOWS/WIN.INI','windows',k,'')
+    start='''@ECHO OFF
+RESERVE > RESERVE.TXT
+IF ERRORLEVEL 1 GOTO BAD
+SET PATH=C:\\WINDOWS;Z:\\
+SET TEMP=C:\\WINDOWS\\TEMP
+CD WINDOWS
+WIN /R
+CD \\
+ECHO RETURNED > RETURNED.TXT
+GOTO DONE
+:BAD
+ECHO RESERVE_FAILED > RETURNED.TXT
+:DONE
+EXIT
+'''
+    (guest/'START.BAT').write_bytes(start.replace('\n','\r\n').encode())
+    conf=f'''[sdl]
+fullscreen=false
+output=surface
+[dosbox]
+machine=tandy
+memsize=1
+captures={dest/'captures'}
+[cpu]
+core=normal
+cputype=8086_prefetch
+cycles=fixed 25000
+fpu=false
+[dos]
+xms=false
+ems=false
+umb=false
+[mixer]
+nosound=true
+[speaker]
+tandy=on
+[autoexec]
+@echo off
+mount C "{guest}"
+C:
+START.BAT
+'''
+    (dest/'RUN.CNF').write_bytes(conf.replace('\n','\r\n').encode())
+    si=subprocess.STARTUPINFO();si.dwFlags|=subprocess.STARTF_USESHOWWINDOW;si.wShowWindow=0
+    started=time.monotonic()
+    with lease(),(dest/'HOST.LOG').open('w') as out:
+        r=subprocess.run([str(Path(os.environ['TANDI_DOSBOX'])),'-nopromptfolder','-conf',str(dest/'RUN.CNF')],stdout=out,stderr=subprocess.STDOUT,timeout=180,startupinfo=si,creationflags=subprocess.CREATE_NO_WINDOW)
+    log=(guest/'TS10.LOG').read_text() if (guest/'TS10.LOG').exists() else ''
+    sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+    result={'mode':mode,'tag':tag,'protocol':'fourth-saver actual source','returncode':r.returncode,'seconds':time.monotonic()-started,'log':log,'exe_sha256':sha(P/'src/TANDI.EXE'),'database_sha256':sha(guest/'WINDOWS/TANDY.DAT'),'driver_sha256':sha(guest/'WINDOWS/SYSTEM/TRIAL.DRV'),'returned':(guest/'RETURNED.TXT').read_text() if (guest/'RETURNED.TXT').exists() else None}
+    result['shell_qa_sha256']=sha(guest/'WINDOWS/TS10QA.EXE')
+    result['optional_shell_sha256']=sha(P.parent/'TSHELL/TSHELL.EXE')
+    (dest/'RESULT.JSN').write_text(json.dumps(result,indent=2))
+    print(json.dumps({k:v for k,v in result.items() if k!='log'},indent=2),flush=True)
+    assert r.returncode==0 and result['returned'] and 'RETURNED' in result['returned']
+    assert 'COMPLETE PASS' in log and ' FAIL' not in log,log
+    return result
+if __name__=='__main__':run(sys.argv[1],sys.argv[2])
