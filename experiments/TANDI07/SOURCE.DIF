+ ('think',72,104),('worry',176,104),('lookleft',228,104),('lookright',280,104)]
+for i,(name,x,y) in enumerate(FACES):
+ CROPS.append(('face '+name,'PARTS.PNG',(x,y,x+24,y+18),((i%4)*32,416+(i//4)*20)))
+atlas=Image.new('RGB',(128,476));report=[]
 for name,file,rect,at in CROPS:
  im=Image.open(P/'art'/file).convert('RGB');sprite=im.crop(rect);atlas.paste(sprite,at)
